#!/usr/bin/env bash
# imgv - a terminal file browser. Its main job is image previews on a slow
# link.
set -o nounset
shopt -s extglob

# bashfs: begin config.bash
# Constants and the mutable state of the program.

readonly VERSION=0.1.0
readonly PROG=imgv

# Timing. Names that end in _S hold seconds, names that end in _MS hold milliseconds.
readonly TICK_IDLE_S=0.25     # loop period when nothing is pending
readonly TICK_BUSY_S=0.02     # loop period while a job or a timer is pending
readonly ESC_WAIT_S=0.05      # longest gap inside one escape sequence
readonly DEBOUNCE_MS=120      # the selection must rest this long before a job starts
readonly HANDSHAKE_MS=3000    # wait this long for the terminal to answer the first queries
readonly ACK_TIMEOUT_MS=4000  # wait this long for one acknowledgement
readonly RETRY_MS=1000        # pause before an image that tmux dropped goes out again
readonly CHECK_MS=1500        # watch tmux for a loss this long after the last byte of an image
readonly STATUS_MS=5000      # a status message stays this long in the footer
readonly FOCUS_CACHE_MS=300   # ask tmux about the pane focus at most this often

# Transfer of image data.
readonly CHUNK=4096           # protocol limit: base64 characters in one graphics command
readonly BURST=65536          # bytes written between looks at the keyboard
readonly WIN_START=16384      # first window size
readonly WIN_MIN=4096
readonly WIN_MAX=524288
readonly WIN_TARGET_MS=250    # one window must drain in about this time

# Rendering.
readonly THUMB_EDGE=256                        # long edge of the draft stage, in pixels
readonly -a QUALITY_EDGE=(0 384 768 1280 0)
readonly -a QUALITY_NAME=('' draft normal fine full)
readonly DIRECT_PNG_MAX=196608   # a PNG file below this size goes to the terminal.
readonly MAX_UPSCALE=4           # a small image grows by this factor at most
readonly CACHE_MAX=48            # finished preview jobs kept for the session
readonly TEXT_LINES=200          # lines of a text or directory preview
readonly WIDE_MIN_COLS=72        # below this width the panes stack
readonly DETAIL_ROWS=10

# Styles. Only attributes and the base colors, so the terminal theme decides the look.
readonly S_RESET=$'\e[0m'
readonly S_BOLD=$'\e[1m'
readonly S_DIM=$'\e[2m'
readonly S_SEL=$'\e[7m'
readonly S_BAR=$'\e[7m'
readonly S_DIR=$'\e[1;34m'
readonly S_LINK=$'\e[36m'
readonly S_ERR=$'\e[31m'

# Sets every global that the program changes while it runs.
state_init() {
	RUNNING=1 MODE=normal NOW=0
	FRAME=
	STATUS='' STATUS_AT=0
	RUN_DIR='' TERM_READY=0 STTY_SAVED='' TMUX_RESTORE=0 IN_TMUX=0
	HAVE_FFMPEG=0 HAVE_FFPROBE=0 HAVE_FILE=0
	# The stat options that print the size and time of an entry, and its mode and owner.
	STAT_LIST=() STAT_MODE=()

	# Options.
	QUALITY=2 SHOW_HIDDEN=0 SORT=name RATE_BPS=131072 START_PATH=.

	# Screen geometry, in cells. L = list, P = preview, D = details.
	ROWS=24 COLS=80 TOO_SMALL=0 ZOOM=0 RESIZED=0
	L_X=1 L_Y=2 L_W=0 L_H=0 P_X=1 P_Y=2 P_W=0 P_H=0 D_X=1 D_Y=2 D_W=0 D_H=0
	SEP_COL=0 SEP_ROW=0
	CELL_W=10 CELL_H=20 CELL_KNOWN=0 CELL_WAIT_UNTIL=0

	# What must be drawn again.
	D_ALL=1 D_HEADER=0 D_LIST=0 D_DETAILS=0 D_PREVIEW=0 D_FOOTER=0
	DIRTY_ROWS=()

	# Directory listing.
	N=0 CUR=0 TOP=0
	E_NAME=() E_KIND=() E_LINK=() E_SIZE=() E_MTIME=() E_IMG=()
	declare -gA DIR_SEL=()
	SEARCH='' SEARCH_FROM=0

	# Preview pipeline.
	PENDING=0 PENDING_AT=0
	JOB_DIR='' JOB_PID=0 JOB_KEY='' JOB_FINISHED=0 JOB_SEQ=0
	GOT_INFO=0 GOT_TEXT=0 GOT_ERR=0 GOT_GEOM=0
	JOB_INFO=() DET=()
	PV_KIND=none PV_MSG='' PV_TEXT=() PV_PAINTED=''
	IMG_W=0 IMG_H=0 STAGES=0 STAGE_DONE=0 TX_STAGE=0 STAGE_W=0 STAGE_H=0 STAGE_BYTES=0
	BOX_X=0 BOX_Y=0 BOX_C=0 BOX_R=0
	declare -gA CACHE=()
	CACHE_ORDER=()

	# Graphics and link state.
	GFX=unknown ACK_MODE=unknown
	GFX_PRE='' GFX_SUF='' DSR='' PH='' DIA=() ID_A=0 ID_B=0
	SHOWN_ID=0 SHOWN_PH='' OLD_ID=0
	HS_PENDING=0 HS_NEED=0 HS_AT=0
	PROBES=0 ACKS=0 ACK_SEEN=0 ACK_MISSES=0
	RTT_MS=0 LINK_BPS=0 WIN_CAP=$WIN_MAX
	FOCUS_AT=-100000 FOCUS_OK=0
	TX_ACTIVE=0 TX_FD=0 TX_ID=0 TX_STARTED=0 TX_EOF=0 TX_WAIT=0 TX_PAUSED=0
	TX_TOTAL=0 TX_SENT=0 TX_WIN=$WIN_START
	RATE_NOW=0 TX_DISCARDED=0 TX_CHECK_UNTIL=0 TX_CHECK_AT=0 TMUX_TAKEN=0 TMUX_DISCARDED=0
	TX_BASE=-1 TX_LOST=0 TX_RETRY_AT=0 TX_WIN_SENT=0 TX_WIN_AT=0 TX_PROBE_AT=0 TX_NEED=0
}
# bashfs: end config.bash
# bashfs: begin util.bash
# Small helpers with no terminal or file-system state.

die() {
	printf '%s: %s\n' "$PROG" "$*" >&2
	exit 1
}

# Sets NOW to the wall clock in milliseconds. It does not fork.
now_ms() {
	local t=$EPOCHREALTIME
	NOW=$(( ${t%[.,]*} * 1000 + 10#${t#*[.,]} / 1000 ))
}

# Shows a message in the footer for a short time.
status() {
	# A message can come before the loop runs, when NOW still holds its start value.
	now_ms
	STATUS=$1 STATUS_AT=$NOW D_FOOTER=1
}

# Sets REPLY to a byte count in a short form, for example "3.4 MiB".
human_size() {
	local n=$1 unit
	if (( n < 1024 )); then
		REPLY="$n B"
		return
	fi
	for unit in KiB MiB GiB TiB; do
		if (( n < 1048576 )) || [[ $unit == TiB ]]; then
			REPLY="$(( n / 1024 )).$(( n % 1024 * 10 / 1024 )) $unit"
			return
		fi
		(( n /= 1024 ))
	done
}

# Succeeds when the file name $1 has the extension of an image format.
is_image() {
	case ${1,,} in
		*.png | *.jpg | *.jpeg | *.jpe | *.jfif | *.gif | *.webp | *.bmp | *.tif | *.tiff) return 0 ;;
		*.exr | *.hdr | *.avif | *.heic | *.heif | *.jxl | *.ico | *.tga | *.ppm | *.pgm | *.pbm | *.pnm | *.qoi | *.svg) return 0 ;;
	esac
	return 1
}

# Sets REPLY to the cell width of the code point in $1.
char_width() {
	local cp=$1
	REPLY=1
	(( cp < 0x300 )) && return
	if (( (cp >= 0x300 && cp <= 0x36F) || (cp >= 0x1AB0 && cp <= 0x1AFF) ||
		(cp >= 0x200B && cp <= 0x200F) || (cp >= 0x20D0 && cp <= 0x20FF) ||
		(cp >= 0xFE00 && cp <= 0xFE0F) )); then
		REPLY=0
	elif (( (cp >= 0x1100 && cp <= 0x115F) || (cp >= 0x2E80 && cp <= 0xA4CF) ||
		(cp >= 0xAC00 && cp <= 0xD7A3) || (cp >= 0xF900 && cp <= 0xFAFF) ||
		(cp >= 0xFE30 && cp <= 0xFE6F) || (cp >= 0xFF00 && cp <= 0xFF60) ||
		(cp >= 0xFFE0 && cp <= 0xFFE6) || (cp >= 0x1F300 && cp <= 0x1FAFF) ||
		(cp >= 0x20000 && cp <= 0x3FFFD) )); then
		REPLY=2
	fi
}

# Sets REPLY to $1 cut or padded to exactly $2 cells. A cut ends in an ellipsis.
fit() {
	local s=${1//[[:cntrl:]]/?} w=$2
	if (( w <= 0 )); then
		REPLY=
		return
	fi
	local n=${#s}
	if [[ $s != *[!\ -~]* ]]; then
		if (( n > w )); then
			REPLY="${s:0:w-1}…"
		else
			printf -v REPLY '%-*s' "$w" "$s"
		fi
		return
	fi
	local out='' used=0 i ch cp cw
	for (( i = 0; i < n; i++ )); do
		ch=${s:i:1}
		printf -v cp '%d' "'$ch"
		char_width "$cp"
		cw=$REPLY
		if (( cw == 0 )); then
			out+=$ch
			continue
		fi
		# The last character can use the cell that the ellipsis needs.
		if (( used + cw > w )) || (( used + cw == w && i < n - 1 )); then
			out+=…
			(( used++ ))
			break
		fi
		out+=$ch
		(( used += cw ))
	done
	printf -v REPLY '%s%*s' "$out" $(( w - used )) ''
}

# Sets FIT_W and FIT_H to the size of $1 x $2 shrunk into $3 x $4. It never enlarges.
fit_px() {
	local w=$1 h=$2 bw=$3 bh=$4
	FIT_W=$w FIT_H=$h
	if (( w > bw || h > bh )); then
		if (( w * bh > h * bw )); then
			FIT_W=$bw FIT_H=$(( h * bw / w ))
		else
			FIT_H=$bh FIT_W=$(( w * bh / h ))
		fi
	fi
	(( FIT_W < 1 )) && FIT_W=1
	(( FIT_H < 1 )) && FIT_H=1
	return 0
}

# Sets REPLY to a line of $1 copies of the string $2.
repeat() {
	printf -v REPLY '%*s' "$1" ''
	REPLY=${REPLY// /$2}
}
# bashfs: end util.bash
# bashfs: begin terminal.bash
# The terminal: modes, size, tmux, and the queries that the terminal answers.

term_init() {
	STTY_SAVED=$(stty -g) || die 'cannot read the terminal settings'
	stty -echo -icanon -ixon min 1 time 0
	# Alternate screen, hidden cursor, no automatic line wrap.
	printf '\e[?1049h\e[?25l\e[?7l'
	TERM_READY=1
}

term_restore() {
	(( TERM_READY )) || return 0
	TERM_READY=0
	printf '\e[0m\e[?7h\e[?25h\e[?1049l'
	stty "$STTY_SAVED"
}

term_size() {
	local size
	size=$(stty size 2>/dev/null) || size='24 80'
	ROWS=${size% *} COLS=${size#* }
}

# Sets REPLY to $1 in a form that reaches the outer terminal through tmux.
wrap_passthrough() {
	if (( IN_TMUX )); then
		REPLY=$'\ePtmux;'${1//$'\e'/$'\e\e'}$'\e\\'
	else
		REPLY=$1
	fi
}

# tmux drops passthrough sequences unless the pane allows them.
# tmux versions without the option always allow them.
tmux_setup() {
	local value
	value=$(tmux show-options -Apv -t "$TMUX_PANE" allow-passthrough 2>/dev/null) || return 0
	[[ $value == on || $value == all ]] && return 0
	tmux set-option -p -t "$TMUX_PANE" allow-passthrough on 2>/dev/null ||
		die 'tmux blocks image data: run "tmux set -g allow-passthrough on", or use --no-images'
	TMUX_RESTORE=1
}

# tmux writes "_" in place of the cells of an image for a client that is
# not in UTF-8 mode. Succeeds when the client can show those cells.
tmux_utf8() {
	local flag
	flag=$(tmux display-message -p -t "$TMUX_PANE" '#{client_utf8}' 2>/dev/null) || return 0
	[[ $flag != 0 ]]
}

tmux_restore() {
	(( TMUX_RESTORE )) || return 0
	TMUX_RESTORE=0
	tmux set-option -p -u -t "$TMUX_PANE" allow-passthrough 2>/dev/null
}

# tmux discards its whole output queue for a client when the queue grows past
# eight bytes for each cell of that client. A window must stay well below that.
tmux_window_cap() {
	WIN_CAP=$WIN_MAX
	(( IN_TMUX )) || return 0
	local size
	size=$(tmux display-message -p -t "$TMUX_PANE" '#{client_width}x#{client_height}' 2>/dev/null) || size=
	local w=${size%x*} h=${size#*x}
	[[ $w == +([0-9]) && $h == +([0-9]) ]] || { w=$COLS h=$ROWS; }
	WIN_CAP=$(( w * h * 4 ))
	(( WIN_CAP < WIN_MIN )) && WIN_CAP=$WIN_MIN
	(( WIN_CAP > WIN_MAX )) && WIN_CAP=$WIN_MAX
	(( TX_WIN > WIN_CAP )) && TX_WIN=$WIN_CAP
	return 0
}

# tmux sends an answer to the active pane, whichever pane asked.
pane_focused() {
	(( IN_TMUX )) || return 0
	if (( NOW - FOCUS_AT >= FOCUS_CACHE_MS )); then
		FOCUS_AT=$NOW
		local state
		state=$(tmux display-message -p -t "$TMUX_PANE" \
			'#{pane_active}#{window_active}#{pane_in_mode}#{session_attached}' 2>/dev/null) || state=
		[[ $state == 110[1-9]* ]]
		FOCUS_OK=$?
	fi
	return "$FOCUS_OK"
}

# Asks the terminal for the cell size in pixels. The answer arrives as input.
cell_query() {
	pane_focused || return 0
	wrap_passthrough $'\e[16t'
	printf '%s' "$REPLY"
	CELL_WAIT_UNTIL=$(( NOW + 500 ))
}

# Handles the answer to cell_query: "6;height;width".
cell_reply() {
	local rest=${1#6;} h w
	h=${rest%%;*} w=${rest#*;}
	[[ $h == +([0-9]) && $w == +([0-9]) ]] || return 0
	(( h > 0 && w > 0 )) || return 0
	CELL_WAIT_UNTIL=0
	(( CELL_KNOWN && h == CELL_H && w == CELL_W )) && return 0
	CELL_W=$w CELL_H=$h CELL_KNOWN=1
	preview_restart
}

# Sends the first queries: cell size, graphics support, and one status report.
# The terminal answers in order, so the status report closes the handshake.
handshake_send() {
	local out
	wrap_passthrough $'\e[16t'
	out=$REPLY
	out+="${GFX_PRE}i=1,s=1,v=1,a=q,t=d,f=24;AAAA${GFX_SUF}${DSR}"
	printf '%s' "$out"
	(( PROBES++ ))
	HS_NEED=$PROBES HS_AT=$NOW HS_PENDING=1
}

handshake_tick() {
	(( HS_PENDING )) || return 0
	if (( ACKS >= HS_NEED )); then
		HS_PENDING=0 ACK_MODE=on
		RTT_MS=$(( NOW - HS_AT ))
		(( RTT_MS < 1 )) && RTT_MS=1
		if [[ $GFX == unknown ]]; then
			GFX=unsupported
			status 'this terminal does not answer the kitty graphics query: previews are off'
		fi
	elif (( NOW - HS_AT > HANDSHAKE_MS )); then
		HS_PENDING=0 ACKS=$PROBES
		ack_mode_off
		[[ $GFX == unknown ]] && GFX=on
	else
		return 0
	fi
	D_DETAILS=1 D_PREVIEW=1
}
# bashfs: end terminal.bash
# bashfs: begin layout.bash
# Screen layout. All values are in cells, and positions start at one.
#
#   wide                               narrow (stacked)
#   +--------------------------+       +-----------------+
#   | header                   |       | header          |
#   | list  | preview          |       | list            |
#   |       |                  |       |-----------------|
#   |       | details          |       | preview         |
#   | footer                   |       | details         |
#   +--------------------------+       | footer          |
#                                      +-----------------+

layout() {
	term_size
	tmux_window_cap
	TOO_SMALL=0 SEP_COL=0 SEP_ROW=0
	L_W=0 L_H=0 P_W=0 P_H=0 D_W=0 D_H=0
	if (( COLS < 20 || ROWS < 6 )); then
		TOO_SMALL=1
		return
	fi
	local body_y=2 body_h=$(( ROWS - 2 ))
	# The right-hand region holds the preview and, below it, the details.
	local r_x=1 r_y=$body_y r_w=$COLS r_h=$body_h
	if (( ZOOM )); then
		:
	elif (( COLS >= WIDE_MIN_COLS )); then
		L_X=1 L_Y=$body_y L_H=$body_h
		L_W=$(( COLS * 30 / 100 ))
		(( L_W < 26 )) && L_W=26
		(( L_W > 46 )) && L_W=46
		SEP_COL=$(( L_W + 1 ))
		r_x=$(( SEP_COL + 2 ))
		r_w=$(( COLS - r_x + 1 ))
	else
		L_X=1 L_Y=$body_y L_W=$COLS
		L_H=$(( body_h * 30 / 100 ))
		(( L_H < 3 )) && L_H=3
		SEP_ROW=$(( body_y + L_H ))
		r_y=$(( SEP_ROW + 1 ))
		r_h=$(( body_h - L_H - 1 ))
	fi

	D_X=$r_x D_W=$r_w
	D_H=$(( r_h * 2 / 5 ))
	(( D_H > DETAIL_ROWS )) && D_H=$DETAIL_ROWS
	(( r_h < 5 || D_W < 16 )) && D_H=0
	P_X=$r_x P_Y=$r_y P_W=$r_w
	P_H=$(( D_H ? r_h - D_H - 1 : r_h ))
	(( P_H < 1 )) && P_H=0
	D_Y=$(( P_Y + P_H + 1 ))
	(( P_W > ${#DIA[@]} )) && P_W=${#DIA[@]}
	return 0
}

# Computes the cells that the image covers: BOX_C x BOX_R at BOX_X, BOX_Y.
# The image keeps its aspect ratio and sits in the center of the preview pane.
box_compute() {
	local pw=$(( P_W * CELL_W )) ph=$(( P_H * CELL_H ))
	local scale=$(( pw * 1000 / IMG_W )) other=$(( ph * 1000 / IMG_H ))
	(( other < scale )) && scale=$other
	(( scale > MAX_UPSCALE * 1000 )) && scale=$(( MAX_UPSCALE * 1000 ))
	local dw=$(( IMG_W * scale / 1000 )) dh=$(( IMG_H * scale / 1000 ))
	BOX_C=$(( (dw + CELL_W - 1) / CELL_W ))
	BOX_R=$(( (dh + CELL_H - 1) / CELL_H ))
	(( BOX_C < 1 )) && BOX_C=1
	(( BOX_R < 1 )) && BOX_R=1
	(( BOX_C > P_W )) && BOX_C=$P_W
	(( BOX_R > P_H )) && BOX_R=$P_H
	BOX_X=$(( P_X + (P_W - BOX_C) / 2 ))
	BOX_Y=$(( P_Y + (P_H - BOX_R) / 2 ))
}

# Sets FIT_W and FIT_H to the largest pixel size that the last stage can use.
stage_limit() {
	local pw=$(( P_W * CELL_W )) ph=$(( P_H * CELL_H )) edge=${QUALITY_EDGE[QUALITY]}
	FIT_W=$pw FIT_H=$ph
	(( edge == 0 )) && return 0
	(( FIT_W > edge )) && FIT_W=$edge
	(( FIT_H > edge )) && FIT_H=$edge
	return 0
}
# bashfs: end layout.bash
# bashfs: begin directory.bash
# The directory listing and the selection.

# Prints one record for each entry of the current directory: the type of the
# target, the type of the entry and the size. This also covers the time and
# the name. A NUL ends each record. The output of stat names no file, so its
# lines pair with the names by position.
dir_scan() {
	shopt -s nullglob
	(( SHOW_HIDDEN )) && shopt -s dotglob
	local -a entries=() meta=()
	local name target type try i=0
	# An entry can go away between both reads. The scan then starts again.
	for (( try = 0; try < 3; try++ )); do
		entries=(*)
		(( ${#entries[@]} )) || return 0
		mapfile -t meta < <(printf './%s\0' "${entries[@]}" | xargs -0 stat "${STAT_LIST[@]}")
		(( ${#meta[@]} == ${#entries[@]} )) && break
	done
	(( ${#meta[@]} == ${#entries[@]} )) || return 1
	for name in "${entries[@]}"; do
		target=o type=f
		[[ -L $name ]] && type=l
		if [[ -d $name ]]; then
			target=d
		elif [[ -f $name ]]; then
			target=f
		fi
		printf '%s/%s/%s/%s\0' "$target" "$type" "${meta[i++]}" "$name"
	done
}

# Reads the current directory into the E_* arrays. Directories come first.
dir_load() {
	local -a sort_args
	case $SORT in
		time) sort_args=(-t/ '-k4,4nr') ;;
		size) sort_args=(-t/ '-k3,3nr') ;;
		*) sort_args=(-t/ -k5 -f -V) ;;
	esac

	local -a dn=() dl=() ds=() dm=() fn=() fk=() fl=() fs=() fm=() fimg=()
	local target type size mtime name reason=
	# A name cannot hold a slash, so the slash is a safe field separator.
	while IFS=/ read -r -d '' target type size mtime name; do
		if [[ $target == d ]]; then
			dn+=("$name") ds+=("$size") dm+=("${mtime%.*}")
			[[ $type == l ]] && dl+=(1) || dl+=(0)
			continue
		fi
		fn+=("$name") fs+=("$size") fm+=("${mtime%.*}")
		[[ $type == l ]] && fl+=(1) || fl+=(0)
		if [[ $target != f ]]; then
			fk+=(o) fimg+=(0)
			continue
		fi
		fk+=(f)
		if is_image "$name"; then
			fimg+=(1)
		else
			fimg+=(0)
		fi
	done < <(
		set -o pipefail
		{ dir_scan | sort -z "${sort_args[@]}"; } 2> "$RUN_DIR/list.err"
	)
	# The messages of the tools would damage the screen, so the footer shows the first one.
	if ! wait "$!"; then
		IFS= read -r reason < "$RUN_DIR/list.err"
		status "cannot list this directory: ${reason:-no message}"
	fi

	local -a dk=() di=()
	local i
	for (( i = 0; i < ${#dn[@]}; i++ )); do
		dk+=(d) di+=(0)
	done
	E_NAME=("${dn[@]}" "${fn[@]}")
	E_KIND=("${dk[@]}" "${fk[@]}")
	E_LINK=("${dl[@]}" "${fl[@]}")
	E_SIZE=("${ds[@]}" "${fs[@]}")
	E_MTIME=("${dm[@]}" "${fm[@]}")
	E_IMG=("${di[@]}" "${fimg[@]}")
	N=${#E_NAME[@]}
	[[ -r . && -x . ]] || status "cannot read $PWD"
}

# Sets REPLY to the index of the entry named $1, or to zero.
dir_find() {
	local i
	REPLY=0
	[[ -n $1 ]] || return 0
	for (( i = 0; i < N; i++ )); do
		if [[ ${E_NAME[i]} == "$1" ]]; then
			REPLY=$i
			return 0
		fi
	done
}

# Enters the directory $1 and selects the entry named $2 when it exists.
dir_change() {
	local from=$PWD
	(( N > 0 )) && DIR_SEL[$from]=${E_NAME[CUR]}
	if ! cd -- "$1" 2>/dev/null; then
		status "cannot open $1"
		return 1
	fi
	dir_load
	dir_find "${2:-${DIR_SEL[$PWD]-}}"
	CUR=$REPLY TOP=0
	scroll_fix
	D_ALL=1
	preview_reset
}

# Loads the directory again and keeps the selection on the same name.
dir_reload() {
	local name=
	(( N > 0 )) && name=${E_NAME[CUR]}
	dir_load
	dir_find "$name"
	CUR=$REPLY TOP=0
	scroll_fix
	D_ALL=1
	preview_reset
}

# Moves the top of the list so that the selection is visible.
# The list moves by half a page, which costs fewer redraws on a slow link.
# Returns success when the top moved.
scroll_fix() {
	local top=$TOP h=$L_H
	(( h < 1 )) && h=1
	if (( CUR < TOP )); then
		TOP=$(( CUR - h / 2 ))
	elif (( CUR >= TOP + h )); then
		TOP=$(( CUR - h + 1 + h / 2 ))
	fi
	(( TOP > N - h )) && TOP=$(( N - h ))
	(( TOP < 0 )) && TOP=0
	(( TOP != top ))
}

select_index() {
	local i=$1 old=$CUR
	(( i >= N )) && i=$(( N - 1 ))
	(( i < 0 )) && i=0
	(( i == CUR )) && return 0
	CUR=$i
	if scroll_fix; then
		D_LIST=1
	else
		DIRTY_ROWS+=("$old" "$CUR")
	fi
	D_FOOTER=1
	preview_reset
}

# Opens the selection: a directory is entered, an image is zoomed.
open_selection() {
	(( N > 0 )) || return 0
	case ${E_KIND[CUR]} in
		d) dir_change "${E_NAME[CUR]}" ;;
		f) (( E_IMG[CUR] )) && zoom_toggle ;;
	esac
}

zoom_toggle() {
	ZOOM=$(( ! ZOOM ))
	layout
	scroll_fix
	D_ALL=1
	preview_restart
}

# Selects the next entry whose name holds the search text. $1 is the direction.
search_jump() {
	local step=$1 start=$2 i k name needle=${SEARCH,,}
	[[ -n $needle ]] || return 1
	for (( k = 0; k < N; k++ )); do
		i=$(( (start + k * step % N + N) % N ))
		name=${E_NAME[i],,}
		if [[ $name == *"$needle"* ]]; then
			select_index "$i"
			return 0
		fi
	done
	return 1
}
