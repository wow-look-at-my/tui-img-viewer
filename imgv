# bashfs: begin input.bash
# Keyboard input. The answers of the terminal arrive on the same stream.
#
# The terminal is in a mode where a read never blocks. One plain read then
# takes every byte that waits, on each bash version. INBUF collects the
# bytes, and input_dispatch takes whole keys and whole sequences from it.

# Appends the bytes that wait on the terminal to INBUF.
input_poll() {
	local part
	while IFS= read -r part; do
		# A line feed ended this read, and it is input too.
		INBUF+=$part$'\n'
	done
	INBUF+=$part
}

# Collects input. $1 says how long to wait for the first byte: "none",
# "busy" for one short tick, or "idle" for a long one.
input_wait() {
	local wait=$1 before=${#INBUF} c rc
	input_poll
	if (( ${#INBUF} == before )) && [[ $wait != none ]]; then
		if (( READ_FRAC )); then
			local t=$TICK_IDLE_S
			[[ $wait == busy ]] && t=$TICK_BUSY_S
			# bash makes this read wait for one byte. A byte that arrives at
			# the end of the time is in c, and the status says: timeout.
			c=
			IFS= read -r -n 1 -d '' -t "$t" c
			rc=$?
			if [[ -n $c ]]; then
				INBUF+=$c
				input_poll
			elif (( rc > 0 && rc <= 128 )); then
				# End of input: the terminal is gone.
				RUNNING=0
			fi
		else
			# The timed read of an older bash can drop the key that arrives
			# at the end of the time. That bash sleeps and then looks. The
			# sleep is short while a key was recent.
			if [[ $wait == busy ]] || (( NOW - INBUF_AT < KEYS_RECENT_MS )); then
				"${NAP[@]}"
			else
				"${NAP_IDLE[@]}"
				# A look gives no sign that the terminal is gone.
				[[ -t 0 ]] || RUNNING=0
			fi
			input_poll
		fi
	fi
	if (( ${#INBUF} != before )); then
		now_ms
		INBUF_AT=$NOW
	fi
	return 0
}

# Handles every whole key and answer in INBUF. A sequence that is not whole
# stays there for the next call. NOW must be current.
input_dispatch() {
	local buf=$INBUF pos=0 c
	local len=${#buf}
	while (( pos < len && RUNNING )); do
		c=${buf:pos:1}
		KEY=
		if [[ $c == $'\e' ]]; then
			input_escape || break
		else
			(( pos++ ))
			case $c in
				$'\n' | $'\r') KEY=ENTER ;;
				$'\x7f' | $'\b') KEY=BS ;;
				$'\t') KEY=TAB ;;
				*) KEY=$c ;;
			esac
		fi
		[[ -n $KEY ]] && handle_key "$KEY"
	done
	INBUF=${buf:pos}
}

# Takes the escape sequence at pos in buf, and moves pos behind it. Fails
# when the end of the sequence did not arrive yet. A sequence that stays
# open too long is dropped, and an escape byte with nothing after it is a key.
input_escape() {
	local c=${buf:pos + 1:1} i final=''
	local late=$(( NOW - INBUF_AT >= ESC_WAIT_MS ))
	case $c in
		'')
			(( late )) || return 1
			KEY=ESC
			(( pos++ ))
			;;
		$'\e')
			# The escape key, and then a sequence. An answer of the terminal can follow the key in the same read.
			KEY=ESC
			(( pos++ ))
			;;
		'[')
			# A control sequence ends at the first byte from "@" to "~".
			for (( i = pos + 2; i < len && i < pos + 36; i++ )); do
				final=${buf:i:1}
				[[ $final == [@-~] ]] && break
				final=
			done
			if [[ -n $final ]]; then
				csi_dispatch "${buf:pos + 2:i - pos - 2}" "$final"
				pos=$(( i + 1 ))
			elif (( i < len || late )); then
				pos=$i
			else
				return 1
			fi
			;;
		O)
			if (( pos + 2 < len )); then
				csi_dispatch '' "${buf:pos + 2:1}"
				(( pos += 3 ))
			elif (( late )); then
				pos=$len
			else
				return 1
			fi
			;;
		_ | P | ']' | '^')
			# A string sequence ends with a bell or with the string terminator.
			local rest=${buf:pos + 2} st=$'\e\\'
			local a=${rest%%$'\a'*} b=${rest%%"$st"*}
			if (( ${#a} < ${#b} )); then
				pos=$(( pos + 2 + ${#a} + 1 ))
				b=$a
			elif (( ${#b} < ${#rest} )); then
				pos=$(( pos + 2 + ${#b} + 2 ))
			elif (( late || ${#rest} > 256 )); then
				pos=$len
				return 0
			else
				return 1
			fi
			[[ $c == _ ]] && gfx_reply "$b"
			;;
		*)
			(( pos += 2 ))
			;;
	esac
	return 0
}

# Maps a control sequence to a key name or to an answer handler.
csi_dispatch() {
	local params=$1 final=$2
	case $final in
		A) KEY=UP ;;
		B) KEY=DOWN ;;
		C) KEY=RIGHT ;;
		D) KEY=LEFT ;;
		H) KEY=HOME ;;
		F) KEY=END ;;
		'~')
			case ${params%%;*} in
				1 | 7) KEY=HOME ;;
				4 | 8) KEY=END ;;
				5) KEY=PGUP ;;
				6) KEY=PGDN ;;
			esac
			;;
		n) [[ $params == 0 ]] && ack_received ;;
		t) [[ $params == 6\;* ]] && cell_reply "$params" ;;
	esac
	return 0
}

search_key() {
	case $1 in
		ENTER)
			MODE=normal
			;;
		ESC)
			MODE=normal
			select_index "$SEARCH_FROM"
			;;
		BS)
			if [[ -z $SEARCH ]]; then
				MODE=normal
			else
				# One character can hold several bytes. Its first byte goes last.
				local b=128
				while [[ -n $SEARCH ]] && (( (b & 0xC0) == 0x80 )); do
					printf -v b '%d' "'${SEARCH: -1}"
					SEARCH=${SEARCH%?}
				done
				search_jump 1 "$SEARCH_FROM"
			fi
			;;
		?)
			SEARCH+=$1
			# A character that is not ASCII arrives as several keys.
			U_S=$SEARCH
			local i=0
			while (( i < ${#SEARCH} )); do
				utf8_at "$i"
				(( U_CP < 0 )) && break
				(( i += U_LEN ))
			done
			if (( i == ${#SEARCH} )); then
				search_jump 1 "$SEARCH_FROM" || status "no match for: $SEARCH"
			fi
			;;
	esac
	D_FOOTER=1
}

quality_step() {
	local q=$(( QUALITY + $1 ))
	(( q < 1 || q >= ${#QUALITY_NAME[@]} )) && return 0
	QUALITY=$q
	status "preview quality: ${QUALITY_NAME[QUALITY]}"
	preview_restart
}

filter_toggle() {
	if [[ $FILTER == smooth ]]; then
		FILTER=nearest
	else
		FILTER=smooth
	fi
	status "scaling: $FILTER"
	preview_restart
}

images_toggle() {
	case $GFX in
		on)
			GFX=off
			status 'image previews: off'
			;;
		unknown)
			return 0
			;;
		noutf8)
			if ! tmux_utf8; then
				status 'tmux is still not in UTF-8 mode: attach with "tmux -u"'
				return 0
			fi
			# The terminal is asked again, since the first answers were not kept.
			GFX=unknown
			handshake_send
			status 'image previews: on'
			;;
		*)
			# A terminal that gave no answer before is asked again.
			if [[ $GFX == off && $ACK_MODE == unknown ]]; then
				GFX=unknown
				handshake_send
			else
				GFX=on
			fi
			status 'image previews: on'
			;;
	esac
	preview_restart
}

handle_key() {
	local key=$1 page=$(( ROWS - 3 ))
	(( page < 1 )) && page=1
	case $MODE in
		help)
			MODE=normal D_ALL=1
			return
			;;
		search)
			search_key "$key"
			return
			;;
	esac
	if [[ -n $STATUS ]]; then
		STATUS='' D_FOOTER=1
	fi
	case $key in
		q) RUNNING=0 ;;
		j | DOWN) select_index $(( CUR + 1 )) ;;
		k | UP) select_index $(( CUR - 1 )) ;;
		g | HOME) select_index 0 ;;
		G | END) select_index $(( N - 1 )) ;;
		PGDN | $'\x06' | ' ') select_index $(( CUR + page )) ;;
		PGUP | $'\x02') select_index $(( CUR - page )) ;;
		$'\x04') select_index $(( CUR + page / 2 )) ;;
		$'\x15') select_index $(( CUR - page / 2 )) ;;
		l | RIGHT | ENTER) open_selection ;;
		h | LEFT | BS) dir_change .. "${PWD##*/}" ;;
		'~') dir_change "$HOME" ;;
		z | TAB) zoom_toggle ;;
		+ | =) quality_step 1 ;;
		- | _) quality_step -1 ;;
		i) images_toggle ;;
		f) filter_toggle ;;
		.)
			SHOW_HIDDEN=$(( ! SHOW_HIDDEN ))
			dir_reload
			;;
		s)
			case $SORT in
				name) SORT='time' ;;
				time) SORT='size' ;;
				*) SORT='name' ;;
			esac
			dir_reload
			;;
		r) dir_reload ;;
		$'\x0c')
			D_ALL=1
			preview_restart
			;;
		/)
			MODE=search SEARCH='' SEARCH_FROM=$CUR D_FOOTER=1
			;;
		n) search_jump 1 $(( CUR + 1 )) || status 'no match' ;;
		N) search_jump -1 $(( CUR - 1 )) || status 'no match' ;;
		'?')
			MODE=help D_ALL=1
			;;
	esac
	return 0
}
# bashfs: end input.bash
# bashfs: begin main.bash
# Start-up, the main loop, and shutdown.

usage() {
	cat <<EOF
$PROG $VERSION - terminal file browser with image previews

Usage: $PROG [options] [directory | file]

Options:
  -a, --all            show dotfiles (the default)
  -H, --hide-dotfiles  start with dotfiles hidden
  -n, --no-images      start with image previews off
  -q, --quality LEVEL  preview quality: draft, normal, fine, full (default: normal)
  -f, --filter MODE    scaling: smooth or nearest (default: smooth)
      --no-preload     load only the selected image, not the images near it
      --rate KIB       send rate in KiB/s when the terminal gives no answers (default: 128)
  -h, --help           show this text
  -V, --version        show the version

Image previews need a terminal with the kitty graphics protocol (Ghostty, kitty).
They work inside tmux. ffmpeg decodes the images. Without ffmpeg only PNG files
have a preview. Press ? in the program for the keys.
EOF
}

parse_args() {
	local arg i
	while (( $# )); do
		arg=$1
		shift
		case $arg in
			-a | --all) SHOW_HIDDEN=1 ;;
			-H | --hide-dotfiles) SHOW_HIDDEN=0 ;;
			--no-preload) PRELOAD=0 ;;
			-f | --filter)
				(( $# )) || die "$arg needs a value"
				[[ $1 == smooth || $1 == nearest ]] || die "unknown filter: $1 (use smooth or nearest)"
				FILTER=$1
				shift
				;;
			-n | --no-images) GFX=off ;;
			-q | --quality)
				(( $# )) || die "$arg needs a value"
				QUALITY=0
				for (( i = 1; i < ${#QUALITY_NAME[@]}; i++ )); do
					[[ $1 == "${QUALITY_NAME[i]}" || $1 == "$i" ]] && QUALITY=$i
				done
				(( QUALITY )) || die "unknown quality: $1 (use draft, normal, fine or full)"
				shift
				;;
			--rate)
				(( $# )) || die "$arg needs a value"
				if [[ $1 != +([0-9]) ]] || (( $1 < 1 )); then
					die "--rate needs a positive number of KiB/s, not: $1"
				fi
				RATE_BPS=$(( $1 * 1024 ))
				shift
				;;
			-h | --help)
				usage
				exit 0
				;;
			-V | --version)
				printf '%s %s\n' "$PROG" "$VERSION"
				exit 0
				;;
			--)
				(( $# )) && START_PATH=$1
				(( $# > 1 )) && die 'too many arguments'
				return 0
				;;
			-*) die "unknown option: $arg (see --help)" ;;
			*)
				[[ $START_PATH == . ]] || die 'too many arguments'
				START_PATH=$arg
				;;
		esac
	done
}

cleanup() {
	trap - EXIT
	if (( TERM_READY )); then
		tx_abort
		# Every image of this program leaves the terminal.
		local id out=
		for id in "${RES_ID[@]}" $SHOWN_ID $OLD_IDS; do
			(( id )) && out+="${GFX_PRE}q=2,a=d,d=I,i=${id}${GFX_SUF}"
		done
		printf '%s' "$out"
		term_restore
	fi
	job_kill
	pf_stop
	tmux_restore
	[[ -n $RUN_DIR ]] && rm -rf -- "$RUN_DIR"
	return 0
}

on_resize() {
	RESIZED=0
	layout
	scroll_fix
	D_ALL=1
	now_ms
	[[ $GFX == on ]] && cell_query
	preview_restart
}

# Finds what this bash and the tools of this host can do. A host with
# busybox tools and an old bash has less than a GNU system.
probe_host() {
	local major=${BASH_VERSINFO[0]} minor=${BASH_VERSINFO[1]} out
	# An older bash can drop the byte that arrives at the end of a read timeout.
	(( major >= 5 )) && READ_FRAC=1
	(( major > 4 || (major == 4 && minor >= 2) )) && TIME_BUILTIN=1
	if (( ! READ_FRAC )); then
		if sleep "$TICK_BUSY_S" 2>/dev/null; then
			NAP=(sleep "$TICK_BUSY_S") NAP_IDLE=(sleep "$TICK_IDLE_S")
		elif command -v usleep >/dev/null; then
			NAP=(usleep 20000) NAP_IDLE=(usleep 250000)
		else
			NAP=(sleep 1) NAP_IDLE=(sleep 1)
			status 'this host has no short sleep: the screen follows slowly'
		fi
	fi
	# GNU and busybox date take the time after "-d @", BSD date after "-r".
	date -d @0 +%s >/dev/null 2>&1 || DATE_OPT=-r DATE_PRE=''

	if command -v ffmpeg >/dev/null; then
		ff_caps
		if [[ -n $FF_OUT ]]; then
			HAVE_FFMPEG=1
		elif [[ $GFX != off ]]; then
			status 'this ffmpeg cannot write PNG files: only PNG files have a preview'
		fi
	elif [[ $GFX != off ]]; then
		status 'ffmpeg is not installed: only PNG files have a preview'
	fi
	command -v ffprobe >/dev/null && HAVE_FFPROBE=1
	command -v file >/dev/null && HAVE_FILE=1
	# GNU and busybox stat take the format after -c, BSD stat after -f.
	if stat -c %s . >/dev/null 2>&1; then
		STAT_LIST=(-c '%s/%Y') STAT_MODE=(-c '%A  %U:%G')
		# Not every stat knows the time with a fraction.
		out=$(stat -c '%s/%.9Y' . 2>/dev/null) || out=
		[[ $out == +([0-9])/+([0-9])?(.+([0-9])) ]] && STAT_LIST=(-c '%s/%.9Y')
	else
		STAT_LIST=(-f '%z/%Fm') STAT_MODE=(-f '%Sp  %Su:%Sg')
	fi
	# Not every sort knows the order of version numbers.
	SORT_NAME=(-t/ -k5 -f)
	sort -V < /dev/null > /dev/null 2>&1 && SORT_NAME+=(-V)

	# The image details and the previews read bytes with od and write them with base64.
	out=$(printf 'A' | od -An -v -tu1 -j 0 -N 1 2>/dev/null) || out=
	if [[ $out != *65* ]]; then
		status 'the od of this host cannot read bytes: images show no details and no preview'
	elif [[ $(printf 'A' | base64 2>/dev/null) != QQ== ]]; then
		status 'base64 is not installed: images have no preview'
	fi
}

main() {
	(( BASH_VERSINFO[0] > 3 || (BASH_VERSINFO[0] == 3 && BASH_VERSINFO[1] >= 2) )) || die 'bash 3.2 or later is needed'
	[[ -n ${EPOCHREALTIME-} || -r /proc/uptime ]] || die 'this bash has no clock: use bash 5, or a host with /proc/uptime'
	# The program handles text as bytes and reads UTF-8 with its own code.
	export LC_ALL=C
	state_init
	parse_args "$@"

	local start_name=
	if [[ -d $START_PATH ]]; then
		cd -- "$START_PATH" || die "cannot open $START_PATH"
	elif [[ -e $START_PATH ]]; then
		start_name=${START_PATH##*/}
		[[ $START_PATH == */* ]] && { cd -- "${START_PATH%/*}/" || die "cannot open ${START_PATH%/*}"; }
	else
		die "no such file or directory: $START_PATH"
	fi
	[[ -t 0 && -t 1 ]] || die 'needs a terminal on standard input and output'

	probe_host
	[[ -n ${TMUX-} && -n ${TMUX_PANE-} ]] && IN_TMUX=1

	RUN_DIR=$(mktemp -d "${TMPDIR:-/tmp}/$PROG.XXXXXX") || die 'cannot create a work directory'
	trap cleanup EXIT
	(( HAVE_FFMPEG )) && ff_check_dir
	trap 'exit 130' INT
	trap 'exit 143' TERM HUP
	trap 'RESIZED=1' WINCH

	gfx_init
	if (( IN_TMUX )) && [[ $GFX != off ]]; then
		tmux_setup
	fi
	term_init
	layout
	dir_load
	dir_find "$start_name"
	CUR=$REPLY
	scroll_fix
	if (( IN_TMUX )) && [[ $GFX != off ]] && ! tmux_utf8; then
		GFX=noutf8
		status 'tmux is not in UTF-8 mode, so images cannot show: attach with "tmux -u"'
	fi
	preview_reset
	render
	# The handshake time is the first round trip of the link.
	now_ms
	[[ $GFX == off ]] || handshake_send

	while (( RUNNING )); do
		preview_timeout
		# A sequence that is not whole yet needs a look soon.
		[[ -n $INBUF && $REPLY == idle ]] && REPLY=busy
		input_wait "$REPLY"
		now_ms
		# All keys that wait are handled before one redraw.
		input_dispatch
		now_ms
		(( RESIZED )) && on_resize
		if [[ -n $STATUS ]] && (( NOW - STATUS_AT > STATUS_MS )); then
			STATUS='' D_FOOTER=1
		fi
		preview_tick
		render
	done
}
# bashfs: end main.bash

main "$@"
