	alpha=0
	((META_TEXTRA && (META_TSPP == -1 || META_TSPP >= 2))) && alpha=1
	META[alpha]=$alpha
	case $META_TPHOTO in
	0 | 1) if ((alpha)); then META[color]=Gray+Alpha; else META[color]=Gray; fi ;;
	2) if ((alpha)); then META[color]=RGBA; else META[color]=RGB; fi ;;
	3) META[color]=Palette ;;
	5) META[color]=CMYK ;;
	6) META[color]=YCbCr ;;
	esac
	case $META_TCOMP in
	-1) ;;
	1) META[detail]=None ;;
	5) META[detail]=LZW ;;
	6 | 7) META[detail]=JPEG ;;
	8 | 32946) META[detail]=Deflate ;;
	32773) META[detail]=PackBits ;;
	*) META[detail]=$META_TCOMP ;;
	esac
	return 0
}

# meta_chlist FILE OFFSET END walks an EXR channel list. META_S gets the names,
# each with a space on both sides, and META_N the pixel type of the first channel.
meta_chlist() {
	local f=$1 p=$2 end=$3 k names=" " ptype=-1
	for ((k = 0; k < 1024; k++)); do
		meta_cstr "$f" "$p" $((end - p)) 0 || return 1
		((META_N == p + 1)) && break
		names+="$META_S "
		p=$META_N
		((p + 16 <= end)) || return 1
		if ((ptype < 0)); then
			meta_need "$f" "$p" 4 || return 1
			meta_le32 "$META_I"
			ptype=$META_N
		fi
		p=$((p + 16))
	done
	((ptype >= 0)) || return 1
	META_S=$names
	META_N=$ptype
}

meta_exr() {
	local f=$1 pos=8 i ver name type size vpos x0 y0 ptype=-1 comp=-1 chans="" d
	local -a cnames=(none RLE ZIPS ZIP PIZ PXR24 B44 B44A DWAA DWAB)
	meta_need "$f" 0 8 || return 1
	meta_le32 4
	ver=$META_N
	(((ver & 255) == 2)) || return 1
	# A multi-part file ends its first header with the same NUL, so the walk reads only that part.
	for ((i = 0; i < 256; i++)); do
		meta_need "$f" "$pos" 1 || return 1
		((META_B[META_I])) || break
		meta_cstr "$f" "$pos" 256 0 || return 1
		name=$META_S
		meta_cstr "$f" "$META_N" 256 0 || return 1
		type=$META_S
		vpos=$((META_N + 4))
		meta_need "$f" "$META_N" 4 || return 1
		meta_le32 "$META_I"
		size=$META_N
		((size < 0x80000000 && vpos + size < 1048576)) || return 1
		case $name:$type in
		dataWindow:box2i)
			((size == 16)) && meta_need "$f" "$vpos" 16 || return 1
			meta_sle32 "$META_I"
			x0=$META_N
			meta_sle32 $((META_I + 4))
			y0=$META_N
			meta_sle32 $((META_I + 8))
			META[width]=$((META_N - x0 + 1))
			meta_sle32 $((META_I + 12))
			META[height]=$((META_N - y0 + 1))
			;;
		channels:chlist)
			meta_chlist "$f" "$vpos" $((vpos + size)) || return 1
			chans=$META_S
			ptype=$META_N
			;;
		compression:compression)
			((size >= 1)) && meta_need "$f" "$vpos" 1 || return 1
			comp=${META_B[META_I]}
			;;
		esac
		pos=$((vpos + size))
	done
	((i < 256 && ptype >= 0 && comp >= 0)) && [[ -n ${META[width]-} ]] || return 1
	case $ptype in
	0) META[bits]=32 && d=uint ;;
	1) META[bits]=16 && d=half ;;
	2) META[bits]=32 && d=float ;;
	*) return 1 ;;
	esac
	if ((comp < ${#cnames[@]})); then d="${cnames[comp]}, $d"; else d="$comp, $d"; fi
	((ver & 0x200)) && d+=", tiled"
	((ver & 0x1000)) && d+=", multi-part"
	((ver & 0x800)) && d+=", deep"
	META[detail]=$d
	if [[ $chans == *" R "* && $chans == *" G "* && $chans == *" B "* ]]; then
		if [[ $chans == *" A "* ]]; then META[color]=RGBA; else META[color]=RGB; fi
	elif [[ $chans == *" Y "* && $chans == *" RY "* && $chans == *" BY "* ]]; then
		META[color]=YCbCr
	elif [[ $chans == *" Y "* ]]; then
		if [[ $chans == *" A "* ]]; then META[color]=Gray+Alpha; else META[color]=Gray; fi
	fi
	if [[ $chans == *" A "* ]]; then META[alpha]=1; else META[alpha]=0; fi
	return 0
}

meta_hdr() {
	local f=$1 pos next line end fmt=RGBE expo=""
	local re='^([-+][XY]) +([0-9]{1,9}) +([-+][XY]) +([0-9]{1,9})$'
	# The text header, the resolution line included, must end within this many bytes.
	end=65536
	meta_find "$f" 0 "$end" 10 || return 1
	pos=$((META_N + 1))
	while :; do
		meta_find "$f" "$pos" $((end - pos)) 10 || return 1
		((META_N == pos)) && break
		next=$((META_N + 1))
		# Only FORMAT and EXPOSURE lines matter; the text of other lines is never built.
		meta_need "$f" "$pos" 1 || return 1
		if ((META_B[META_I] != 69 && META_B[META_I] != 70)); then
			pos=$next
			continue
		fi
		meta_cstr "$f" "$pos" $((next - pos)) 10 || return 1
		pos=$next
		line=$META_S
		case $line in
		FORMAT=32-bit_rle_rgbe) fmt=RGBE ;;
		FORMAT=32-bit_rle_xyze) fmt=XYZE ;;
		FORMAT=*) return 1 ;;
		EXPOSURE=*) [[ -n $expo ]] || expo=${line#EXPOSURE=} ;;
		esac
	done
	pos=$((META_N + 1))
	meta_cstr "$f" "$pos" $((end - pos)) 10 || return 1
	[[ $META_S =~ $re ]] || return 1
	[[ ${BASH_REMATCH[1]:1} != "${BASH_REMATCH[3]:1}" ]] || return 1
	if [[ ${BASH_REMATCH[1]} == ?Y ]]; then
		META[height]=$((10#${BASH_REMATCH[2]}))
		META[width]=$((10#${BASH_REMATCH[4]}))
	else
		META[width]=$((10#${BASH_REMATCH[2]}))
		META[height]=$((10#${BASH_REMATCH[4]}))
	fi
	META[scan_order]="${BASH_REMATCH[1]} ${BASH_REMATCH[3]}"
	META[data_offset]=$META_N
	META[color]=RGB
	META[alpha]=0
	expo=${expo#"${expo%%[! ]*}"}
	META[detail]=$fmt${expo:+, exposure $expo}
	return 0
}

# meta_probe FILE fills META.
meta_probe() {
	local f=${1-} sig rc=1
	META=()
	META_B=()
	META_BOFF=0
	[[ -f $f && -r $f ]] || return 1
	meta_read "$f" 0 4096 || return 1
	printf -v sig '%02x' "${META_B[@]:0:12}"
	case $sig in
	89504e470d0a1a0a*) META[format]=PNG && meta_png "$f" && rc=0 ;;
	ffd8*) META[format]=JPEG && meta_jpeg "$f" && rc=0 ;;
	474946383[79]61*) META[format]=GIF && meta_gif "$f" && rc=0 ;;
	424d*) META[format]=BMP && meta_bmp "$f" && rc=0 ;;
	52494646????????57454250) META[format]=WebP && meta_webp "$f" && rc=0 ;;
	49492a00* | 4d4d002a*) META[format]=TIFF && meta_tiff "$f" && rc=0 ;;
	762f3101*) META[format]=EXR && meta_exr "$f" && rc=0 ;;
	# "#?RADIANCE" or "#?RGBE", then a newline.
	233f52414449414e43450a* | 233f524742450a*) META[format]=HDR && meta_hdr "$f" && rc=0 ;;
	esac
	META_B=()
	if ((rc == 0 && ${META[width]:-0} > 0 && ${META[height]:-0} > 0)); then
		return 0
	fi
	META=()
	return 1
}
# bashfs: end metadata.bash
# bashfs: begin radiance.bash
# Decoder for Radiance HDR pictures (.hdr). Older ffmpeg versions cannot read
# them, so this piece expands the run-length data in bash. It writes planes
# (green, blue, red, exponent), which ffmpeg reads as raw video and turns
# into display colors.

# Expands the scan line that starts at RAD_POS in RAD_HEX, and moves RAD_POS
# behind it. RAD_HEX holds a few characters for each byte: a space and hex
# digits. With $2 = 1 the channels go to RAD_LINE as hex text.
radiance_row() {
	local width=$1 emit=$2 ch filled byte code n pad line
	for ch in 0 1 2 3; do
		filled=0 line=''
		while (( filled < width )); do
			byte=${RAD_HEX:RAD_POS * 3 + 1:2}
			[[ -n $byte ]] || return 1
			code=$(( 16#$byte ))
			(( RAD_POS++ ))
			if (( code > 128 )); then
				# A run: one value, repeated.
				n=$(( code - 128 ))
				if (( emit )); then
					printf -v pad '%*s' "$n" ''
					line+=${pad// /${RAD_HEX:RAD_POS * 3:3}}
				fi
				(( RAD_POS++ ))
			else
				# Literal bytes.
				n=$code
				(( n > 0 )) || return 1
				(( emit )) && line+=${RAD_HEX:RAD_POS * 3:n * 3}
				(( RAD_POS += n ))
			fi
			(( filled += n ))
		done
		(( filled == width )) || return 1
		RAD_LINE[ch]=$line
	done
	return 0
}

# radiance_planes FILE OFFSET WIDTH HEIGHT STEP OUT
# Decodes every STEP-th scan line of the pixel data at OFFSET and writes the
# planes to the file OUT. Sets RAD_ROWS to the count of lines in OUT and
# RAD_FORMAT to the ffmpeg pixel format of OUT.
radiance_planes() {
	local file=$1 offset=$2 width=$3 height=$4 step=$5 out=$6
	# Byte offsets into strings need the C locale.
	local LC_ALL=C
	local hex marker i ch
	local -a rows
	RAD_ROWS=0 RAD_FORMAT=gbrap RAD_LINE=()

	hex=$(od -An -v -tx1 -j "$offset" -- "$file") || return 1
	# GNU od puts one space before each byte and BSD od puts more. The decoder needs exactly one.
	hex=" ${hex//$'\n'/ }"
	while [[ $hex == *'  '* ]]; do
		hex=${hex//  / }
	done
	hex=${hex% }
	# A file with no run-length coding holds a few bytes for each pixel.
	if (( ${#hex} / 3 == width * height * 4 )) && [[ ${hex:0:6} != ' 02 02' ]]; then
		tail -c "+$(( offset + 1 ))" -- "$file" > "$out" || return 1
		RAD_ROWS=$height RAD_FORMAT=rgba
		return 0
	fi
	# The run-length coding has this width limit.
	(( width >= 8 && width < 32768 )) || return 1

	# Each scan line starts with a marker that holds the width. A cut at
	# the markers finds the lines without a walk through all the data.
	printf -v marker ' 02 02 %02x %02x' $(( width >> 8 )) $(( width & 255 ))
	mapfile -t rows <<< "${hex//"$marker"/$'\n'}"
	local fast=1
	(( ${#rows[@]} == height + 1 )) && [[ -z ${rows[0]} ]] || fast=0

	# Each plane collects its lines as hex text.
	local -a plane=('' '' '' '')
	if (( fast )); then
		for (( i = 0; i < height; i += step )); do
			RAD_HEX=${rows[i + 1]} RAD_POS=0
			# A marker pattern inside the data gives a line of the wrong size.
			if ! radiance_row "$width" 1 || (( RAD_POS * 3 != ${#RAD_HEX} )); then
				fast=0
				break
			fi
			for ch in 0 1 2 3; do
				plane[ch]+=${RAD_LINE[ch]}
			done
			(( RAD_ROWS++ ))
		done
	fi
	if (( ! fast )); then
		# The slow way: walk every scan line in order.
		plane=('' '' '' '')
		RAD_HEX=$hex RAD_POS=0 RAD_ROWS=0
		for (( i = 0; i < height; i++ )); do
			[[ ${RAD_HEX:RAD_POS * 3:12} == "$marker" ]] || return 1
			(( RAD_POS += 4 ))
			if (( i % step )); then
				radiance_row "$width" 0 || return 1
				continue
			fi
			radiance_row "$width" 1 || return 1
			for ch in 0 1 2 3; do
				plane[ch]+=${RAD_LINE[ch]}
			done
			(( RAD_ROWS++ ))
		done
	fi
	(( RAD_ROWS > 0 )) || return 1
	# The plane order of the pixel format: green, blue, red, then the exponent.
	for ch in 1 2 0 3; do
		printf '%b' "${plane[ch]// /\\x}"
	done > "$out"
}

# Sets REPLY to the ffmpeg filter that turns the planes into display colors:
# mantissa and exponent become a linear value, and the sRGB curve follows.
radiance_filter() {
	local ch expr=''
	for ch in r g b; do
		expr+="$ch='st(0,$ch(X,Y)*pow(2,alpha(X,Y)-136));"
		expr+="255*clip(if(lte(ld(0),0.0031308),12.92*ld(0),1.055*pow(ld(0),1/2.4)-0.055),0,1)':"
	done
	REPLY="geq=${expr}a=255"
}
# bashfs: end radiance.bash
# bashfs: begin jobs.bash
# Background preview jobs. One job reads one file and writes its results into
# its own directory.

# Starts a job in the background. Sets JOB_PID.
job_spawn() {
	job_main "$@" </dev/null >/dev/null 2>&1 &
	JOB_PID=$!
}

job_main() {
	local kind=$1
	JOB_OUT=$3 JOB_CHILD=0
	trap job_abort TERM
	case $kind in
		image) job_image "${@:2}" ;;
		dir) job_dir "$2" ;;
		file) job_file "$2" ;;
		*) job_other "$2" ;;
	esac
	: > "$JOB_OUT/done"
}

# The main loop stops a job with TERM. The job removes its own directory.
job_abort() {
	(( JOB_CHILD )) && kill "$JOB_CHILD" 2>/dev/null
	rm -rf -- "$JOB_OUT"
	exit 143
}

# Runs a command so that TERM can interrupt it. A trap does not run while
# the shell waits for a foreground command.
job_run() {
	"$@" &
	JOB_CHILD=$!
	wait "$JOB_CHILD"
	local rc=$?
	JOB_CHILD=0
	return "$rc"
}

# Writes the remaining arguments as lines to the result file $1.
job_write() {
	local name=$1
	shift
	printf '%s\n' "$@" > "$JOB_OUT/.$name" && mv -- "$JOB_OUT/.$name" "$JOB_OUT/$name"
}

# Appends the mode, the owner and the link target of $1 to INFO.
job_stat_lines() {
	local path=$1 text
	text=$(stat "${STAT_MODE[@]}" -- "$path" 2>/dev/null) && INFO+=("Mode"$'\t'"$text")
	if [[ -L $path ]]; then
		text=$(readlink -- "$path") && INFO+=("Link"$'\t'"→ $text")
	fi
	return 0
}

job_dir() {
	local path=$1 entry name count=0 images=0
	local -a INFO=() text=()
	shopt -s nullglob
	(( SHOW_HIDDEN )) && shopt -s dotglob
	for entry in "$path"/*; do
		(( count++ ))
		name=${entry##*/}
		is_image "$name" && (( images++ ))
		(( count > TEXT_LINES )) && continue
		[[ -d $entry ]] && name+=/
		text+=("${name//[[:cntrl:]]/?}")
	done
	INFO+=("Type"$'\t'"directory" "Items"$'\t'"$count, images: $images")
	job_stat_lines "$path"
	job_write info "${INFO[@]}"
	(( count == 0 )) && text=('(empty directory)')
	job_write text "${text[@]}"
}

job_file() {
	local path=$1 line
	local -a INFO=() text=() raw=()
	if (( HAVE_FILE )); then
		line=$(file -b -- "$path" 2>/dev/null) && INFO+=("Type"$'\t'"$line")
	fi
	job_stat_lines "$path"
	job_write info "${INFO[@]}"
	if [[ ! -r $path ]]; then
		text=('(not readable)')
	elif [[ ! -s $path ]]; then
		text=('(empty file)')
	elif grep -Iq '' -- "$path" 2>/dev/null; then
		mapfile -t -n "$TEXT_LINES" raw < <(head -c 65536 -- "$path")
		for line in "${raw[@]}"; do
			line=${line//$'\t'/    }
			text+=("${line//[[:cntrl:]]/}")
		done
	else
		text=('(binary file)')
	fi
	job_write text "${text[@]}"
}

job_other() {
	local -a INFO=()
	job_stat_lines "$1"
	(( ${#INFO[@]} )) && job_write info "${INFO[@]}"
	job_write text '(not a regular file)'
}

# Appends the detail lines of the probed image to INFO. $1 and $2 are the
# size after rotation.
job_meta_lines() {
	local w=$1 h=$2 line
	line=${META[format]-image}
	[[ -n ${META[color]-} ]] && line+=" · ${META[color]}"
	[[ -n ${META[bits]-} ]] && line+=" ${META[bits]}-bit"
	[[ -n ${META[detail]-} ]] && line+=" · ${META[detail]}"
	INFO+=("Type"$'\t'"$line")

	local a=$w b=$h t
	while (( b )); do
		t=$(( a % b )) a=$b b=$t
	done
	line="${w}×${h} · $(( w * h / 1000000 )).$(( w * h % 1000000 / 100000 )) MP"
	if (( w / a <= 32 && h / a <= 32 )); then
		line+=" · $(( w / a )):$(( h / a ))"
	else
		line+=" · $(( w / h )).$(( w * 100 / h % 100 / 10 ))$(( w * 100 / h % 10 )):1"
	fi
	(( ${META[orientation]:-1} > 1 )) && line+=" · EXIF rotation ${META[orientation]}"
	INFO+=("Image"$'\t'"$line")

	line=${META[make]-}
	if [[ -n ${META[model]-} ]]; then
		# Many cameras repeat the maker name in the model name.
		[[ -n $line && ${META[model]} != "$line"* ]] && line+=" ${META[model]}" || line=${META[model]}
	fi
	[[ -n $line ]] && INFO+=("Camera"$'\t'"$line")

	line=
	[[ -n ${META[fnumber]-} ]] && line+="f/${META[fnumber]} · "
	[[ -n ${META[exposure]-} ]] && line+="${META[exposure]} s · "
	[[ -n ${META[iso]-} ]] && line+="ISO ${META[iso]} · "
	[[ -n ${META[focal]-} ]] && line+="${META[focal]} mm · "
	[[ -n $line ]] && INFO+=("Shot"$'\t'"${line% · }")
	[[ -n ${META[datetime]-} ]] && INFO+=("Taken"$'\t'"${META[datetime]}")
	[[ -n ${META[lens]-} ]] && INFO+=("Lens"$'\t'"${META[lens]}")
	return 0
}

# Publishes the PNG file $2 as stage $1 with the pixel size $3 x $4.
job_stage() {
	local n=$1 png=$2 bytes
	# GNU base64 breaks its output into lines. The transfer needs one line.
	( set -o pipefail; base64 < "$png" | tr -d '\n' ) > "$JOB_OUT/.s$n.b64" || return 1
	bytes=$(wc -c < "$JOB_OUT/.s$n.b64") || return 1
	# BSD wc puts spaces before the count.
	job_write "s$n.dim" "$3 $4 $(( bytes ))"
	mv -- "$JOB_OUT/.s$n.b64" "$JOB_OUT/s$n.b64"
}

# job_image PATH OUT MAX_W MAX_H FILE_SIZE
# MAX_W x MAX_H is the pixel limit of the last stage. Zero means: details only.
job_image() {
	local path=$1 max_w=$3 max_h=$4 fsize=$5
	local -a INFO=()
	local w=0 h=0 orient=1 format=
	if meta_probe "$path"; then
		w=${META[width]} h=${META[height]} orient=${META[orientation]:-1} format=${META[format]}
		if (( orient >= 5 )); then
			local t=$w
			w=$h h=$t
		fi
		job_meta_lines "$w" "$h"
	elif (( HAVE_FFPROBE )) && job_ffprobe "$path"; then
		w=$PROBE_W h=$PROBE_H
		declare -A META=([format]=$PROBE_CODEC)
		job_meta_lines "$w" "$h"
	fi
	job_stat_lines "$path"
	job_write info "${INFO[@]}"
	if (( w < 1 || h < 1 )); then
		job_write err 'this image format is not recognized'
		return
	fi
	(( max_w > 0 )) || return 0

	# A PNG file that is small enough needs no decoder.
	local direct=0
	if [[ $format == PNG ]] && (( orient == 1 )); then
		(( w <= max_w && h <= max_h && fsize <= DIRECT_PNG_MAX )) && direct=1
		(( HAVE_FFMPEG )) || direct=1
	fi
	if (( direct )); then
		job_write geom "$w $h 1"
		job_stage 1 "$path" "$w" "$h" || job_write err 'cannot read the file'
		return
	fi
	if (( ! HAVE_FFMPEG )); then
		job_write err 'ffmpeg is not installed: only PNG files have a preview'
		return
	fi

	fit_px "$w" "$h" "$max_w" "$max_h"
	local out_w=$FIT_W out_h=$FIT_H
	fit_px "$w" "$h" "$THUMB_EDGE" "$THUMB_EDGE"
	local thumb_w=$FIT_W thumb_h=$FIT_H stages=1
	# A draft stage is useful only when the last stage is larger.
	(( out_w * 2 > thumb_w * 3 )) && stages=2
	job_write geom "$w $h $stages"

	local turn=
	case $orient in
		2) turn=hflip, ;;
		3) turn=hflip,vflip, ;;
		4) turn=vflip, ;;
		5) turn=transpose=0, ;;
		6) turn=transpose=1, ;;
		7) turn=transpose=3, ;;
		8) turn=transpose=2, ;;
	esac
	# ffmpeg reads the file through a link, so no file name can look like an option or a sequence pattern.
	ln -s -- "$path" "$JOB_OUT/src"
	local -a input=(-noautorotate -i "$JOB_OUT/src")
	case $format in
		EXR)
			# The picture holds linear light. The decoder applies the sRGB curve.
			input=(-apply_trc iec61966_2_1 -i "$JOB_OUT/src")
			;;
		HDR)
			if [[ ${META[scan_order]-} == '-Y +X' && $(ffmpeg -hide_banner -decoders 2>/dev/null) == *' hdr '* ]]; then
				# This ffmpeg reads the format. Its output is linear light, so the sRGB curve follows here.
				local curve='if(lte(val/maxval,0.0031308),12.92*val,(1.055*pow(val/maxval,1/2.4)-0.055)*maxval)'
				input=(-i "$JOB_OUT/src")
				turn="format=gbrp16le,lutrgb=r='$curve':g='$curve':b='$curve',"
			elif job_radiance "$path" "$w" "$h" "$out_w" "$out_h"; then
				input=(-f rawvideo -pixel_format "$RAD_FORMAT" -video_size "${w}x$RAD_ROWS" -i "$JOB_OUT/planes")
				turn=$RAD_FILTER
			else
				job_write err 'this Radiance file has a layout that the decoder does not know'
				return
			fi
			;;
	esac
	local pix='format=pix_fmts=rgb24|rgba|gray|ya8' graph
	local -a enc=(-frames:v 1 -c:v png -pred mixed -f image2 -update 1) outs
	if (( stages == 2 )); then
		graph="[0:v]${turn}split=2[a][b];"
		graph+="[a]scale=${thumb_w}:${thumb_h}:flags=bilinear,${pix}[t];"
		graph+="[b]scale=${out_w}:${out_h}:flags=lanczos,${pix}[f]"
		outs=(-map '[t]' "${enc[@]}" "$JOB_OUT/1.png" -map '[f]' "${enc[@]}" "$JOB_OUT/2.png")
	else
		graph="[0:v]${turn}scale=${out_w}:${out_h}:flags=lanczos,${pix}[f]"
		outs=(-map '[f]' "${enc[@]}" "$JOB_OUT/1.png")
	fi
	if ! job_run ffmpeg -nostdin -y -v error "${input[@]}" \
		-filter_complex "$graph" "${outs[@]}" 2> "$JOB_OUT/log"; then
		local reason=
		[[ -s $JOB_OUT/log ]] && reason=$(tail -n 1 -- "$JOB_OUT/log")
		job_write err "ffmpeg cannot decode this file: ${reason:-no message}"
		return
	fi
	if (( stages == 2 )); then
		job_stage 1 "$JOB_OUT/1.png" "$thumb_w" "$thumb_h" &&
			job_stage 2 "$JOB_OUT/2.png" "$out_w" "$out_h"
	else
		job_stage 1 "$JOB_OUT/1.png" "$out_w" "$out_h"
	fi || job_write err 'cannot encode the preview'
}

# Decodes a Radiance picture into raw planes for ffmpeg. Sets RAD_FILTER to
# the filters that turn the planes into a normal picture.
job_radiance() {
	local path=$1 w=$2 h=$3 out_w=$4 out_h=$5 flips=''
	case ${META[scan_order]-} in
		'-Y +X') ;;
		'+Y +X') flips=vflip, ;;
		'-Y -X') flips=hflip, ;;
		'+Y -X') flips=hflip,vflip, ;;
		*) return 1 ;;
	esac
	# Scan lines that the preview cannot show are not decoded.
	local step=$(( h / out_h ))
	(( step < 1 )) && step=1
	radiance_planes "$path" "${META[data_offset]}" "$w" "$h" "$step" "$JOB_OUT/planes" || return 1
	# Mantissa and exponent cannot be averaged, so the first cut in width takes whole pixels.
	local near_w=$(( out_w * 2 ))
	(( near_w > w )) && near_w=$w
	radiance_filter
	RAD_FILTER="scale=${near_w}:${RAD_ROWS}:flags=neighbor,format=gbrap,${REPLY},format=gbrp,${flips}"
}

# Reads the size of a file that the header parser does not know.
job_ffprobe() {
	local line
	ln -s -- "$1" "$JOB_OUT/probe"
	line=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,width,height \
		-of csv=p=0 "$JOB_OUT/probe" 2>/dev/null) || return 1
	IFS=, read -r PROBE_CODEC PROBE_W PROBE_H _ <<< "$line"
	[[ ${PROBE_W-} == +([0-9]) && ${PROBE_H-} == +([0-9]) ]]
}
