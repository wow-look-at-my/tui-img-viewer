# bashfs: begin terminal.bash
# The terminal: modes, size, tmux, and the queries that the terminal answers.

term_init() {
	STTY_SAVED=$(stty -g) || die 'cannot read the terminal settings'
	# With "min 0" a read takes the bytes that wait and never blocks.
	if ! stty -echo -icanon -ixon -icrnl min 0 time 0; then
		stty "$STTY_SAVED"
		die 'cannot set the terminal mode'
	fi
	# Alternate screen, hidden cursor, no automatic line wrap.
	printf '\e[?1049h\e[?25l\e[?7l'
	TERM_READY=1
}

term_restore() {
	(( TERM_READY )) || return 0
	TERM_READY=0
	printf '\e[0m\e[?7h\e[?25h\e[?1049l'
	stty "$STTY_SAVED"
}

term_size() {
	local size
	size=$(stty size 2>/dev/null) || size='24 80'
	ROWS=${size% *} COLS=${size#* }
}

# Sets REPLY to $1 in a form that reaches the outer terminal through tmux.
wrap_passthrough() {
	if (( IN_TMUX )); then
		REPLY=$'\ePtmux;'${1//$'\e'/$'\e\e'}$'\e\\'
	else
		REPLY=$1
	fi
}

# tmux drops passthrough sequences unless the pane allows them.
# tmux versions without the option always allow them.
tmux_setup() {
	local value
	value=$(tmux show-options -Apv -t "$TMUX_PANE" allow-passthrough 2>/dev/null) || return 0
	[[ $value == on || $value == all ]] && return 0
	tmux set-option -p -t "$TMUX_PANE" allow-passthrough on 2>/dev/null ||
		die 'tmux blocks image data: run "tmux set -g allow-passthrough on", or use --no-images'
	TMUX_RESTORE=1
}

# tmux writes "_" in place of the cells of an image for a client that is
# not in UTF-8 mode. Succeeds when the client can show those cells.
tmux_utf8() {
	local flag
	flag=$(tmux display-message -p -t "$TMUX_PANE" '#{client_utf8}' 2>/dev/null) || return 0
	[[ $flag != 0 ]]
}

tmux_restore() {
	(( TMUX_RESTORE )) || return 0
	TMUX_RESTORE=0
	tmux set-option -p -u -t "$TMUX_PANE" allow-passthrough 2>/dev/null
}

# tmux discards its whole output queue for a client when the queue grows past
# eight bytes for each cell of that client. A window must stay well below that.
tmux_window_cap() {
	WIN_CAP=$WIN_MAX
	(( IN_TMUX )) || return 0
	local size
	size=$(tmux display-message -p -t "$TMUX_PANE" '#{client_width}x#{client_height}' 2>/dev/null) || size=
	local w=${size%x*} h=${size#*x}
	[[ $w == +([0-9]) && $h == +([0-9]) ]] || { w=$COLS h=$ROWS; }
	WIN_CAP=$(( w * h * 4 ))
	(( WIN_CAP < WIN_MIN )) && WIN_CAP=$WIN_MIN
	(( WIN_CAP > WIN_MAX )) && WIN_CAP=$WIN_MAX
	(( TX_WIN > WIN_CAP )) && TX_WIN=$WIN_CAP
	return 0
}

# tmux sends an answer to the active pane, whichever pane asked.
pane_focused() {
	(( IN_TMUX )) || return 0
	if (( NOW - FOCUS_AT >= FOCUS_CACHE_MS )); then
		FOCUS_AT=$NOW
		local state
		state=$(tmux display-message -p -t "$TMUX_PANE" \
			'#{pane_active}#{window_active}#{pane_in_mode}#{session_attached}' 2>/dev/null) || state=
		[[ $state == 110[1-9]* ]]
		FOCUS_OK=$?
	fi
	return "$FOCUS_OK"
}

# Asks the terminal for the cell size in pixels. The answer arrives as input.
cell_query() {
	pane_focused || return 0
	wrap_passthrough $'\e[16t'
	printf '%s' "$REPLY"
	CELL_WAIT_UNTIL=$(( NOW + 500 ))
}

# Handles the answer to cell_query: "6;height;width".
cell_reply() {
	local rest=${1#6;} h w
	h=${rest%%;*} w=${rest#*;}
	[[ $h == +([0-9]) && $w == +([0-9]) ]] || return 0
	(( h > 0 && w > 0 )) || return 0
	CELL_WAIT_UNTIL=0
	(( CELL_KNOWN && h == CELL_H && w == CELL_W )) && return 0
	CELL_W=$w CELL_H=$h CELL_KNOWN=1
	preview_restart
}

# Sends the first queries: cell size, graphics support, and one status report.
# The terminal answers in order, so the status report closes the handshake.
handshake_send() {
	local out
	wrap_passthrough $'\e[16t'
	out=$REPLY
	out+="${GFX_PRE}i=1,s=1,v=1,a=q,t=d,f=24;AAAA${GFX_SUF}${DSR}"
	printf '%s' "$out"
	(( PROBES++ ))
	HS_NEED=$PROBES HS_AT=$NOW HS_PENDING=1
}

handshake_tick() {
	(( HS_PENDING )) || return 0
	if (( ACKS >= HS_NEED )); then
		HS_PENDING=0 ACK_MODE=on
		RTT_MS=$(( NOW - HS_AT ))
		(( RTT_MS < 1 )) && RTT_MS=1
		if [[ $GFX == unknown ]]; then
			GFX=unsupported
			status 'this terminal does not answer the kitty graphics query: previews are off'
		fi
	elif (( NOW - HS_AT > HANDSHAKE_MS )); then
		HS_PENDING=0 ACKS=$PROBES
		ack_mode_off
		[[ $GFX == unknown ]] && GFX=on
	else
		return 0
	fi
	D_DETAILS=1 D_PREVIEW=1
}
# bashfs: end terminal.bash
# bashfs: begin layout.bash
# Screen layout. All values are in cells, and positions start at one.
#
#   wide                               narrow (stacked)
#   +--------------------------+       +-----------------+
#   | header                   |       | header          |
#   | list  | preview          |       | list            |
#   |       |                  |       |-----------------|
#   |       | details          |       | preview         |
#   | footer                   |       | details         |
#   +--------------------------+       | footer          |
#                                      +-----------------+

layout() {
	term_size
	tmux_window_cap
	TOO_SMALL=0 SEP_COL=0 SEP_ROW=0
	L_W=0 L_H=0 P_W=0 P_H=0 D_W=0 D_H=0
	if (( COLS < 20 || ROWS < 6 )); then
		TOO_SMALL=1
		return
	fi
	local body_y=2 body_h=$(( ROWS - 2 ))
	# The right-hand region holds the preview and, below it, the details.
	local r_x=1 r_y=$body_y r_w=$COLS r_h=$body_h
	if (( ZOOM )); then
		:
	elif (( COLS >= WIDE_MIN_COLS )); then
		L_X=1 L_Y=$body_y L_H=$body_h
		L_W=$(( COLS * 30 / 100 ))
		(( L_W < 26 )) && L_W=26
		(( L_W > 46 )) && L_W=46
		SEP_COL=$(( L_W + 1 ))
		r_x=$(( SEP_COL + 2 ))
		r_w=$(( COLS - r_x + 1 ))
	else
		L_X=1 L_Y=$body_y L_W=$COLS
		L_H=$(( body_h * 30 / 100 ))
		(( L_H < 3 )) && L_H=3
		SEP_ROW=$(( body_y + L_H ))
		r_y=$(( SEP_ROW + 1 ))
		r_h=$(( body_h - L_H - 1 ))
	fi

	D_X=$r_x D_W=$r_w
	D_H=$(( r_h * 2 / 5 ))
	(( D_H > DETAIL_ROWS )) && D_H=$DETAIL_ROWS
	(( r_h < 5 || D_W < 16 )) && D_H=0
	P_X=$r_x P_Y=$r_y P_W=$r_w
	P_H=$(( D_H ? r_h - D_H - 1 : r_h ))
	(( P_H < 1 )) && P_H=0
	D_Y=$(( P_Y + P_H + 1 ))
	(( P_W > ${#DIA[@]} )) && P_W=${#DIA[@]}
	return 0
}

# Sets CELLS_C x CELLS_R to the cells that an image of $1 x $2 pixels covers in
# the preview pane. The image keeps its aspect ratio.
box_cells() {
	local pw=$(( P_W * CELL_W )) ph=$(( P_H * CELL_H ))
	local scale=$(( pw * 1000 / $1 )) other=$(( ph * 1000 / $2 ))
	(( other < scale )) && scale=$other
	(( scale > MAX_UPSCALE * 1000 )) && scale=$(( MAX_UPSCALE * 1000 ))
	local dw=$(( $1 * scale / 1000 )) dh=$(( $2 * scale / 1000 ))
	CELLS_C=$(( (dw + CELL_W - 1) / CELL_W ))
	CELLS_R=$(( (dh + CELL_H - 1) / CELL_H ))
	(( CELLS_C < 1 )) && CELLS_C=1
	(( CELLS_R < 1 )) && CELLS_R=1
	(( CELLS_C > P_W )) && CELLS_C=$P_W
	(( CELLS_R > P_H )) && CELLS_R=$P_H
	return 0
}

# Computes the cells that the image covers: BOX_C x BOX_R at BOX_X, BOX_Y.
# The image sits in the center of the preview pane.
box_compute() {
	box_cells "$IMG_W" "$IMG_H"
	BOX_C=$CELLS_C BOX_R=$CELLS_R
	BOX_X=$(( P_X + (P_W - BOX_C) / 2 ))
	BOX_Y=$(( P_Y + (P_H - BOX_R) / 2 ))
}

# Sets FIT_W and FIT_H to the largest pixel size that the last stage can use.
stage_limit() {
	local pw=$(( P_W * CELL_W )) ph=$(( P_H * CELL_H )) edge=${QUALITY_EDGE[QUALITY]}
	FIT_W=$pw FIT_H=$ph
	(( edge == 0 )) && return 0
	(( FIT_W > edge )) && FIT_W=$edge
	(( FIT_H > edge )) && FIT_H=$edge
	return 0
}
