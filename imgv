gfx_init() {
	if (( IN_TMUX )); then
		GFX_PRE=$'\ePtmux;\e\e_G' GFX_SUF=$'\e\e\\\e\\'
		DSR=$'\ePtmux;\e\e[5n\e\\'
	else
		GFX_PRE=$'\e_G' GFX_SUF=$'\e\\'
		DSR=$'\e[5n'
	fi
	local hex
	utf8_char 0x10EEEE
	PH=$REPLY
	DIA=()
	for hex in $DIA_HEX; do
		utf8_char "0x$hex"
		DIA+=("$REPLY")
	done
	# The low byte of an image id travels in a color of the base palette,
	# which every terminal setup keeps intact. The process id spreads the ids
	# of two programs in one terminal. The high byte is a slot, see slot_new.
	ID_LO=$(( 16 + $$ % 240 ))
}

# Sets REPLY to an image id that no image of this program uses.
slot_new() {
	local n id
	for (( n = 0; n < SLOT_MAX; n++ )); do
		SLOT=$(( SLOT % SLOT_MAX + 1 ))
		id=$(( SLOT << 24 | ID_LO ))
		(( id == SHOWN_ID || (TX_ACTIVE && id == TX_ID) )) && continue
		[[ " $OLD_IDS " == *" $id "* ]] && continue
		res_has_id "$id" && continue
		REPLY=$id
		return 0
	done
	# RES_MAX keeps slots free, so this point is not reached.
	REPLY=$id
}

# Appends one graphics command to the frame.
gfx_cmd() {
	FRAME+="$GFX_PRE$1$GFX_SUF"
}

# Sets REPLY to the placeholder cells of image $1 at column $2, row $3,
# for a box of $4 columns and $5 rows.
placeholder_block() {
	local id=$1 x=$2 y=$3 cols=$4 rows=$5 row tail='' high=''
	local out=''
	# The third mark holds the high byte of the id.
	(( id >> 24 )) && high=${DIA[id >> 24]}
	# Only the first cell of a row carries its row and column. A cell with
	# no marks continues the cell on its left, which halves the bytes.
	repeat $(( cols - 1 )) "$PH"
	tail=$REPLY
	for (( row = 0; row < rows; row++ )); do
		out+=$'\e['"$(( y + row ));${x}H$PH${DIA[row]}${DIA[0]}$high$tail"
	done
	REPLY=$'\e[38;5;'"$(( id & 255 ))m$out"$'\e[39m'
}

# Handles one answer to a graphics command.
gfx_reply() {
	[[ $1 == Gi=1\;OK* ]] || return 0
	[[ $GFX == unknown || $GFX == unsupported ]] || return 0
	GFX=on
	D_DETAILS=1
	(( HS_PENDING )) || preview_restart
}

# Handles one status report from the terminal.
ack_received() {
	(( ACKS < PROBES )) && (( ACKS++ ))
	ACK_SEEN=1 ACK_MISSES=0
	if [[ $ACK_MODE == off ]] && (( ! HS_PENDING )); then
		ACK_MODE=on ACKS=$PROBES TX_WIN=$WIN_START
		(( TX_WIN > WIN_CAP )) && TX_WIN=$WIN_CAP
		status 'the terminal answers again: flow control is on'
	fi
	return 0
}

# Without answers the program cannot see the link. It then sends at a fixed rate.
ack_mode_off() {
	ACK_MODE=off
	(( RATE_NOW )) || RATE_NOW=$RATE_BPS
	rate_window
	human_size "$RATE_NOW"
	status "the terminal does not answer: no flow control, sending $REPLY/s (--rate)"
}

# Sets the window of the fixed-rate mode: a tenth of a second of data.
rate_window() {
	TX_WIN=$(( RATE_NOW / 10 ))
	(( TX_WIN < CHUNK )) && TX_WIN=$CHUNK
	(( TX_WIN > WIN_CAP )) && TX_WIN=$WIN_CAP
}

# Sets TMUX_TAKEN and TMUX_DISCARDED to two byte counts of the tmux client.
# tmux counts a byte as taken when it queues it, not when the client reads
# it. It counts a byte as discarded when it empties a queue that grew too long.
tmux_counters() {
	(( IN_TMUX )) || return 1
	local reply
	reply=$(tmux display-message -p -t "$TMUX_PANE" '#{client_written}:#{client_discarded}' 2>/dev/null) || return 1
	[[ $reply == +([0-9]):+([0-9]) ]] || return 1
	TMUX_TAKEN=${reply%:*} TMUX_DISCARDED=${reply#*:}
}

# tmux loses image data in two ways, and reports neither to the program.
# It empties its queue when the link is slower than the send rate. It also
# drops data while a redraw of the pane waits behind queued output.
# Succeeds when the counters show a loss. The first kind sets TX_LOST at once.
tmux_dropped() {
	(( TX_BASE >= 0 )) || return 1
	tmux_counters || return 1
	if (( TMUX_DISCARDED > TX_DISCARDED )); then
		TX_LOST=1
		return 0
	fi
	(( TMUX_TAKEN - TX_BASE < TX_SENT ))
}

# After a loss the whole image goes out again, at half the rate. A loss after
# the end damages an image that is already kept in the terminal.
tx_lost() {
	local active=$TX_ACTIVE
	tx_abort
	res_drop_id "$TX_ID"
	if [[ $TX_OWNER == cur ]]; then
		STAGE_DONE=0
	elif (( active )); then
		pf_clear
	fi
	(( RATE_NOW /= 2 ))
	(( RATE_NOW < WIN_MIN )) && RATE_NOW=$WIN_MIN
	rate_window
	now_ms
	TX_LOST=0 TX_CHECK_UNTIL=0
	TX_RETRY_AT=$(( NOW + RETRY_MS ))
	human_size "$RATE_NOW"
	status "tmux dropped image data: sending the image again at $REPLY/s"
}

# The queue of tmux can still overflow a moment after the last byte went
# out. This check finds that loss.
tx_check() {
	(( TX_CHECK_UNTIL )) || return 0
	(( NOW - TX_CHECK_AT >= 200 )) || return 0
	TX_CHECK_AT=$NOW
	(( NOW >= TX_CHECK_UNTIL )) && TX_CHECK_UNTIL=0
	tmux_dropped && (( TX_LOST )) && tx_lost
	return 0
}

# Adapts the window to the time that the last window needed.
link_update() {
	local dt=$1 drain next bps
	(( dt < 1 )) && dt=1
	(( RTT_MS == 0 || dt < RTT_MS )) && RTT_MS=$dt
	bps=$(( TX_WIN_SENT * 1000 / dt ))
	# A small window can pass in one burst of the link. One sample
	# therefore counts as the double of the estimate at most.
	(( LINK_BPS && bps > LINK_BPS * 2 )) && bps=$(( LINK_BPS * 2 ))
	LINK_BPS=$(( LINK_BPS ? (LINK_BPS * 3 + bps) / 4 : bps ))
	# A short last window says little about the link.
	(( TX_WIN_SENT * 2 < TX_WIN )) && return 0
	drain=$(( dt - RTT_MS ))
	(( drain < 1 )) && drain=1
	next=$(( TX_WIN_SENT * WIN_TARGET_MS / drain ))
	(( next > TX_WIN * 2 )) && next=$(( TX_WIN * 2 ))
	(( next < TX_WIN / 2 )) && next=$(( TX_WIN / 2 ))
	(( next < WIN_MIN )) && next=$WIN_MIN
	(( next > WIN_CAP )) && next=$WIN_CAP
	TX_WIN=$next
	D_FOOTER=1
}

# Starts the transfer of the base64 file $1, which holds $2 bytes. No other
# transfer may be active. The caller sets TX_ID, TX_OWNER, TX_C x TX_R (the
# cells), TX_W x TX_H (the pixels), TX_FINAL and TX_RKEY (the key to keep a
# final image under).
tx_begin() {
	[[ -r $1 ]] || return 1
	# The file holds one line for each graphics command. TX_NEXT is one line
	# ahead, so the last line is known as the last.
	exec 8< "$1"
	TX_NEXT=
	IFS= read -r -u 8 TX_NEXT
	TX_ACTIVE=1 TX_STARTED=0 TX_EOF=0 TX_WAIT=0 TX_PAUSED=0
	TX_TOTAL=$2 TX_SENT=0 TX_WIN_SENT=0
	# In fixed-rate mode one question at the start finds a terminal that answers again.
	if [[ $ACK_MODE == off ]] && pane_focused; then
		printf '%s' "$DSR"
		(( PROBES++ ))
	fi
	TX_BASE=-1 TX_LOST=0 TX_CHECK_UNTIL=0
	if [[ $ACK_MODE == off ]] && tmux_counters; then
		TX_BASE=$TMUX_TAKEN
		# A later stage keeps the count of the first one, so a loss
		# between two stages still shows.
		[[ $TX_OWNER == cur ]] && (( STAGE_DONE > 0 )) || TX_DISCARDED=$TMUX_DISCARDED
	fi
	D_DETAILS=1
}

# Stops the transfer. An empty last chunk ends the open command, so the
# terminal drops the partial image.
tx_abort() {
	(( TX_ACTIVE )) || return 0
	exec 8<&-
	local out=
	(( TX_STARTED && ! TX_EOF )) && out+="${GFX_PRE}q=2,m=0;${GFX_SUF}"
	(( TX_STARTED && TX_ID != SHOWN_ID )) && out+="${GFX_PRE}q=2,a=d,d=I,i=${TX_ID}${GFX_SUF}"
	printf '%s' "$out"
	TX_ACTIVE=0 TX_WAIT=0 TX_PAUSED=0
	D_DETAILS=1
}

# Returns success when the window in flight has left the link.
tx_window_released() {
	now_ms
	if [[ $ACK_MODE == on ]]; then
		if (( ACKS >= TX_NEED )); then
			link_update $(( NOW - TX_WIN_AT ))
		elif (( NOW - TX_PROBE_AT < ACK_TIMEOUT_MS )); then
			return 1
		else
			# The answer is lost. Count it as received so the next wait starts clean.
			ACKS=$PROBES
			(( ! ACK_SEEN || ++ACK_MISSES >= 3 )) && ack_mode_off
		fi
	elif (( (NOW - TX_WIN_AT) * RATE_NOW < TX_WIN_SENT * 1000 )); then
		return 1
	elif tmux_dropped; then
		# tmux can be a moment behind with its count of taken bytes, so
		# that verdict waits a little.
		(( NOW - TX_PROBE_AT > 500 )) && TX_LOST=1
		return 1
	fi
	TX_WAIT=0 TX_WIN_SENT=0
	# Fixed-rate mode counts the bytes of tmux, so it must not add screen
	# updates of its own between two windows.
	[[ $ACK_MODE == on ]] && D_DETAILS=1
	return 0
}

# Sends the next part of the image. It returns after one burst at most.
tx_pump() {
	(( TX_ACTIVE )) || return 0
	if (( TX_WAIT )); then
		if ! tx_window_released; then
			(( TX_LOST )) && tx_lost
			return 0
		fi
	fi
	if (( TX_EOF )); then
		tx_done
		return 0
	fi
	if ! pane_focused; then
		(( TX_PAUSED )) || D_DETAILS=1
		TX_PAUSED=1
		return 0
	fi
	(( TX_PAUSED )) && D_DETAILS=1
	TX_PAUSED=0

	local burst=$BURST chunk ctrl more out='' n
	if (( TX_WIN_SENT == 0 )); then
		now_ms
		TX_WIN_AT=$NOW
	fi
	# A window holds whole chunks and never more bytes than TX_WIN.
	while (( burst > 0 && ! TX_EOF && (TX_WIN_SENT == 0 || TX_WIN_SENT + CHUNK <= TX_WIN) )); do
		chunk=$TX_NEXT TX_NEXT=
		IFS= read -r -u 8 TX_NEXT
		[[ -n $TX_NEXT ]] || TX_EOF=1
		more=$(( ! TX_EOF ))
		if (( TX_STARTED )); then
			ctrl="q=2,m=$more"
		else
			ctrl="q=2,a=T,U=1,f=100,i=$TX_ID,c=$TX_C,r=$TX_R,m=$more"
			TX_STARTED=1
		fi
		out+="$GFX_PRE$ctrl;$chunk$GFX_SUF"
		n=${#chunk}
		(( burst -= n, TX_SENT += n, TX_WIN_SENT += n ))
	done
	if (( TX_EOF || TX_WIN_SENT + CHUNK > TX_WIN )); then
		if [[ $ACK_MODE == on ]]; then
			out+=$DSR
			(( PROBES++ ))
			TX_NEED=$PROBES
		fi
		TX_WAIT=1
		now_ms
		TX_PROBE_AT=$NOW
	fi
	printf '%s' "$out"
}

# The whole image is in the terminal. A final image stays there. The image
# of the selection shows, and a preloaded image waits for its turn.
tx_done() {
	exec 8<&-
	TX_ACTIVE=0
	D_DETAILS=1
	(( TX_BASE >= 0 )) && TX_CHECK_UNTIL=$(( NOW + CHECK_MS ))
	(( TX_FINAL )) && res_add "$TX_RKEY" "$TX_ID" "$TX_W $TX_H $TX_TOTAL" $(( TX_W * TX_H * 4 ))
	if [[ $TX_OWNER == pf ]]; then
		pf_clear
		return 0
	fi
	STAGE_DONE=$TX_STAGE
	(( TX_ID == SHOWN_ID )) && return 0
	placeholder_block "$TX_ID" "$BOX_X" "$BOX_Y" "$BOX_C" "$BOX_R"
	(( SHOWN_ID )) && OLD_IDS+=" $SHOWN_ID"
	SHOWN_ID=$TX_ID SHOWN_PH=$REPLY
	PV_KIND=image
	D_PREVIEW=1
}

# Takes the shown image off the screen. An image that the terminal keeps
# stays in the terminal.
image_hide() {
	(( SHOWN_ID )) || return 0
	res_has_id "$SHOWN_ID" || gfx_cmd "q=2,a=d,d=I,i=$SHOWN_ID"
	SHOWN_ID=0 SHOWN_PH=
}

# Images that stay in the terminal. Each one is the last stage of a preview,
# kept under the key of its job, so a return to the entry shows it at once.

# Sets REPLY to the index of the kept image with the key $1.
res_find() {
	local i
	for (( i = ${#RES_KEY[@]} - 1; i >= 0; i-- )); do
		if [[ ${RES_KEY[i]} == "$1" ]]; then
			REPLY=$i
			return 0
		fi
	done
	return 1
}

# Succeeds when the image id $1 is kept. Sets REPLY to its index.
res_has_id() {
	local i
	for (( i = 0; i < ${#RES_ID[@]}; i++ )); do
		if (( RES_ID[i] == $1 )); then
			REPLY=$i
			return 0
		fi
	done
	return 1
}

# res_add KEY ID DIM PIXEL_BYTES keeps a finished image. DIM is "w h bytes".
# The oldest images leave the terminal when there are too many or too large.
res_add() {
	res_find "$1" && res_remove "$REPLY"
	RES_KEY+=("$1") RES_ID+=("$2") RES_DIM+=("$3") RES_PX+=("$4")
	(( RES_TOTAL += $4 ))
	local i=0
	while (( ${#RES_KEY[@]} > RES_MAX || RES_TOTAL > RES_BUDGET )) && (( i < ${#RES_KEY[@]} - 1 )); do
		if (( RES_ID[i] == SHOWN_ID )); then
			(( i++ ))
			continue
		fi
		res_remove "$i"
	done
}

# Removes the kept image at index $1. The terminal frees it unless it shows.
res_remove() {
	local i=$1 id=${RES_ID[$1]}
	(( id == SHOWN_ID )) || gfx_cmd "q=2,a=d,d=I,i=$id"
	(( RES_TOTAL -= RES_PX[i] ))
	RES_KEY=("${RES_KEY[@]:0:i}" "${RES_KEY[@]:i+1}")
	RES_ID=("${RES_ID[@]:0:i}" "${RES_ID[@]:i+1}")
	RES_DIM=("${RES_DIM[@]:0:i}" "${RES_DIM[@]:i+1}")
	RES_PX=("${RES_PX[@]:0:i}" "${RES_PX[@]:i+1}")
}

res_drop_id() {
	res_has_id "$1" && res_remove "$REPLY"
	return 0
}

# Shows the kept image at index $1 as the image of the selection.
res_show() {
	local i=$1 id=${RES_ID[$1]} dim=${RES_DIM[$1]}
	(( TX_ACTIVE )) && [[ $TX_OWNER == cur ]] && tx_abort
	STAGE_W=${dim%% *} dim=${dim#* }
	STAGE_H=${dim%% *} STAGE_BYTES=${dim#* }
	STAGE_DONE=$STAGES TX_STAGE=$STAGES
	# The image moves to the end, as the one with the latest use.
	RES_KEY+=("${RES_KEY[i]}") RES_ID+=("$id") RES_DIM+=("${RES_DIM[i]}") RES_PX+=("${RES_PX[i]}")
	(( RES_TOTAL += RES_PX[i] ))
	(( SHOWN_ID && SHOWN_ID != id )) && OLD_IDS+=" $SHOWN_ID"
	SHOWN_ID=$id
	res_remove "$i"
	placeholder_block "$id" "$BOX_X" "$BOX_Y" "$BOX_C" "$BOX_R"
	SHOWN_PH=$REPLY PV_KIND=image
	D_PREVIEW=1 D_DETAILS=1
}
# bashfs: end graphics.bash
# bashfs: begin preview.bash
# The preview pipeline: selection, then job, then transfer, then picture.
# A finished image stays in the terminal, so a return to it shows it at once.
# When the selection is done, the images near it load ahead.

# The selection changed. Stops the work for the entry and starts the rest
# timer for the new entry. A finished job of the new entry shows at once.
preview_reset() {
	local key=
	if (( N > 0 )); then
		job_args "$CUR"
		key=$JA_KEY
	fi
	# A preload of the new entry continues as its own job.
	[[ -n $PF_KEY && $PF_KEY == "$key" ]] || pf_stop
	(( TX_ACTIVE )) && [[ $TX_OWNER == cur ]] && tx_abort
	job_kill
	image_hide
	JOB_INFO=() PV_TEXT=() PV_KIND=none PV_MSG=
	GOT_INFO=0 GOT_TEXT=0 GOT_ERR=0 GOT_GEOM=0
	STAGES=0 STAGE_DONE=0 TX_STAGE=0
	CUR_KEY=$key PF_NONE=0
	now_ms
	PENDING=1 PENDING_AT=$NOW
	D_DETAILS=1 D_PREVIEW=1
	[[ -n $key ]] || return 0
	if (( ! HS_PENDING && NOW >= CELL_WAIT_UNTIL )) && { [[ $PF_KEY == "$key" ]] || cache_find "$key"; }; then
		job_start
		job_poll
	fi
}

# Starts the preview of the same entry again, for example after a resize.
preview_restart() {
	preview_reset
}

job_kill() {
	if (( JOB_PID && ! JOB_FINISHED )); then
		kill "$JOB_PID" 2>/dev/null
	fi
	JOB_DIR='' JOB_PID=0 JOB_KEY='' JOB_FINISHED=0
}

# The key names everything that the result depends on.
job_args() {
	local i=$1
	JA_PATH=${PWD%/}/${E_NAME[i]} JA_KIND=other JA_ARGS=()
	case ${E_KIND[i]} in
		d) JA_KIND='dir' ;;
		f) JA_KIND='file' ;;
	esac
	if (( E_IMG[i] )); then
		JA_KIND=image
		local max_w=0 max_h=0
		if [[ $GFX == on ]] && (( P_H > 0 )); then
			stage_limit
			max_w=$FIT_W max_h=$FIT_H
		fi
		JA_ARGS=("$max_w" "$max_h" "${E_SIZE[i]}")
	fi
	JA_KEY="$JA_KIND|$JA_PATH|${E_MTIME[i]}|${E_SIZE[i]}|${JA_ARGS[*]}|$SHOW_HIDDEN|$P_W $P_H $CELL_W $CELL_H $FILTER"
}

# Starts the job for the selected entry. A finished job comes from the cache,
# and a preload of the entry becomes its job.
job_start() {
	PENDING=0
	(( N > 0 )) || return 0
	job_args "$CUR"
	CUR_KEY=$JA_KEY
	JOB_FINISHED=0 JOB_PID=0 JOB_KEY=
	if cache_find "$JA_KEY"; then
		JOB_DIR=$REPLY
		[[ $PF_KEY == "$JA_KEY" ]] && (( ! TX_ACTIVE )) && pf_clear
		return 0
	fi
	if [[ -n $PF_DIR && $PF_KEY == "$JA_KEY" ]]; then
		JOB_DIR=$PF_DIR JOB_PID=$PF_PID JOB_KEY=$PF_KEY
		pf_clear
	else
		JOB_DIR=$RUN_DIR/job$(( ++JOB_SEQ )) JOB_KEY=$JA_KEY
		mkdir -p -- "$JOB_DIR" || { status 'cannot create a work directory'; JOB_DIR=; return 0; }
		job_spawn "$JA_KIND" "$JA_PATH" "$JOB_DIR" "${JA_ARGS[@]}"
		JOB_PID=$REPLY
	fi
	if [[ $JA_KIND == image ]] && (( JA_ARGS[0] > 0 )); then
		PV_KIND=msg PV_MSG='loading…' D_PREVIEW=1
	fi
}

# Sets REPLY to the directory of the finished job with the key $1.
cache_find() {
	local i
	for (( i = 0; i < ${#CACHE_KEY[@]}; i++ )); do
		if [[ ${CACHE_KEY[i]} == "$1" && -e ${CACHE_DIR[i]}/done ]]; then
			REPLY=${CACHE_DIR[i]}
			return 0
		fi
	done
	return 1
}

# Keeps the finished job with the key $1 in the directory $2 for the session.
# The oldest job leaves the cache first.
cache_add() {
	CACHE_KEY+=("$1") CACHE_DIR+=("$2")
	(( ${#CACHE_KEY[@]} > CACHE_MAX )) || return 0
	rm -rf -- "${CACHE_DIR[0]}"
	CACHE_KEY=("${CACHE_KEY[@]:1}") CACHE_DIR=("${CACHE_DIR[@]:1}")
}

# Picks up the result files that the job has published since the last look.
job_poll() {
	[[ -n $JOB_DIR ]] || return 0
	local dir=$JOB_DIR
	if (( ! GOT_INFO )) && [[ -e $dir/info ]]; then
		read_lines JOB_INFO "$dir/info"
		GOT_INFO=1 D_DETAILS=1
	fi
	if (( ! GOT_TEXT )) && [[ -e $dir/text ]]; then
		read_lines PV_TEXT "$dir/text"
		GOT_TEXT=1 PV_KIND=text D_PREVIEW=1
	fi
	if (( ! GOT_ERR )) && [[ -e $dir/err ]]; then
		IFS= read -r PV_MSG < "$dir/err"
		GOT_ERR=1 PV_KIND=error D_PREVIEW=1 D_DETAILS=1
	fi
	if (( ! GOT_GEOM )) && [[ -e $dir/geom ]]; then
		read -r IMG_W IMG_H STAGES < "$dir/geom"
		GOT_GEOM=1
		box_compute
	fi
	if (( GOT_GEOM && STAGE_DONE < STAGES )) && [[ $GFX == on ]]; then
		if res_find "$CUR_KEY"; then
			res_show "$REPLY"
		elif (( ! TX_ACTIVE && NOW >= TX_RETRY_AT )); then
			stage_send
		fi
	fi
	if (( ! JOB_FINISHED )) && [[ -e $dir/done ]]; then
		JOB_FINISHED=1
		[[ -n $JOB_KEY ]] && cache_add "$JOB_KEY" "$dir"
		JOB_KEY=
	fi
	return 0
}

# Starts the transfer of the next stage that is ready.
stage_send() {
	local dir=$JOB_DIR stage=$(( STAGE_DONE + 1 ))
	# The draft stage only helps when the last stage needs a long time.
	if (( stage < STAGES )) && [[ -e $dir/s$STAGES.b64 ]] && (( LINK_BPS > 0 )); then
		local w h bytes
		read -r w h bytes < "$dir/s$STAGES.dim"
		(( bytes * 1000 / LINK_BPS < WIN_TARGET_MS * 2 )) && stage=$STAGES
	fi
	[[ -e $dir/s$stage.b64 ]] || return 0
	read -r STAGE_W STAGE_H STAGE_BYTES < "$dir/s$stage.dim"
	TX_STAGE=$stage
	# A later stage of the shown image keeps its id. The terminal then
	# replaces the picture in place, and the cells stay as they are.
	if (( SHOWN_ID && STAGE_DONE > 0 )); then
		TX_ID=$SHOWN_ID
	else
		slot_new
		TX_ID=$REPLY
	fi
	TX_OWNER=cur TX_C=$BOX_C TX_R=$BOX_R TX_W=$STAGE_W TX_H=$STAGE_H
	TX_FINAL=$(( stage == STAGES )) TX_RKEY=$CUR_KEY
	tx_begin "$dir/s$stage.b64" "$STAGE_BYTES"
}

# Stops the preload: its transfer and its job.
pf_stop() {
	[[ -n $PF_KEY ]] || return 0
	(( TX_ACTIVE )) && [[ $TX_OWNER == pf ]] && tx_abort
	if (( PF_PID && ! PF_FINISHED )); then
		if [[ -e $PF_DIR/done ]]; then
			cache_add "$PF_KEY" "$PF_DIR"
		else
			kill "$PF_PID" 2>/dev/null
		fi
	fi
	pf_clear
}

pf_clear() {
	PF_KEY='' PF_DIR='' PF_PID=0 PF_FINISHED=0
}

# Starts the preload of the next image near the selection that the terminal
# does not have yet. Images in the direction of the last move come first.
pf_pick() {
	local d s i
	for (( d = 1; d <= PRELOAD_RADIUS; d++ )); do
		for s in "$MOVE_DIR" $(( -MOVE_DIR )); do
			i=$(( CUR + s * d ))
			(( i >= 0 && i < N )) || continue
			(( E_IMG[i] )) || continue
			job_args "$i"
			res_find "$JA_KEY" && continue
			[[ $PF_SKIP == *$'\n'"$JA_KEY"$'\n'* ]] && continue
			PF_KEY=$JA_KEY PF_PID=0 PF_FINISHED=0
			if cache_find "$JA_KEY"; then
				PF_DIR=$REPLY PF_FINISHED=1
				return 0
			fi
			PF_DIR=$RUN_DIR/job$(( ++JOB_SEQ ))
			if ! mkdir -p -- "$PF_DIR"; then
				pf_clear
				return 1
			fi
			job_spawn "$JA_KIND" "$JA_PATH" "$PF_DIR" "${JA_ARGS[@]}"
			PF_PID=$REPLY
			return 0
		done
	done
	PF_NONE=1
	return 1
}

# One step of the preload. It waits until the selection has its whole preview.
preload_tick() {
	(( PRELOAD && N > 0 )) && [[ $GFX == on ]] || return 0
	(( ! PENDING && ! HS_PENDING && NOW >= CELL_WAIT_UNTIL && NOW - PENDING_AT >= DEBOUNCE_MS )) || return 0
	[[ -z $JOB_DIR ]] || (( JOB_FINISHED )) || return 0
	if (( E_IMG[CUR] )) && [[ $PV_KIND != error ]]; then
		(( GOT_GEOM && STAGE_DONE >= STAGES )) || return 0
	fi
	(( TX_ACTIVE )) && [[ $TX_OWNER == cur ]] && return 0
	if [[ -z $PF_KEY ]]; then
		(( PF_NONE )) && return 0
		pf_pick || return 0
	fi
	if (( ! PF_FINISHED )); then
		[[ -e $PF_DIR/done ]] || return 0
		PF_FINISHED=1
		cache_add "$PF_KEY" "$PF_DIR"
	fi
	(( TX_ACTIVE || TX_CHECK_UNTIL || NOW < TX_RETRY_AT )) && return 0
	local w h stages bytes
	if [[ ! -e $PF_DIR/geom ]]; then
		# This image has no preview, for example a damaged file.
		PF_SKIP+="$PF_KEY"$'\n'
		pf_clear
		return 0
	fi
	read -r w h stages < "$PF_DIR/geom"
	if [[ ! -e $PF_DIR/s$stages.dim ]]; then
		PF_SKIP+="$PF_KEY"$'\n'
		pf_clear
		return 0
	fi
	box_cells "$w" "$h"
	slot_new
	TX_ID=$REPLY TX_OWNER=pf TX_C=$CELLS_C TX_R=$CELLS_R TX_FINAL=1 TX_RKEY=$PF_KEY
	read -r TX_W TX_H bytes < "$PF_DIR/s$stages.dim"
	tx_begin "$PF_DIR/s$stages.b64" "$bytes" || pf_clear
}

# Sets REPLY to the text of the Preview line in the details.
preview_status() {
	REPLY=
	(( N > 0 && E_IMG[CUR] )) || return 0
	case $GFX in
		off) REPLY='off (press i)'; return ;;
		unsupported) REPLY='no graphics support in this terminal (press i to force)'; return ;;
		unknown) REPLY='asking the terminal…'; return ;;
		noutf8) REPLY='tmux is not in UTF-8 mode: attach with "tmux -u", then press i'; return ;;
	esac
	if [[ $PV_KIND == error ]]; then
		REPLY='failed'
		return
	fi
	local label=draft size
	if (( TX_ACTIVE )) && [[ $TX_RKEY == "$CUR_KEY" ]]; then
		(( TX_FINAL )) && label=${QUALITY_NAME[QUALITY]}
		human_size "$TX_TOTAL"
		size=$REPLY
		if [[ $ACK_MODE == on ]]; then
			REPLY="$label ${TX_W}×${TX_H} · $(( TX_TOTAL ? TX_SENT * 100 / TX_TOTAL : 0 ))% of $size"
		else
			REPLY="$label ${TX_W}×${TX_H} · sending $size, no flow control"
		fi
		(( TX_PAUSED )) && REPLY+=' · paused, pane not focused'
		return
	fi
	(( TX_STAGE >= STAGES )) && label=${QUALITY_NAME[QUALITY]}
	if (( STAGE_DONE > 0 )); then
		human_size "$STAGE_BYTES"
		REPLY="$label ${STAGE_W}×${STAGE_H} · $REPLY"
		(( STAGE_DONE < STAGES )) && REPLY+=' · refining…'
		return
	fi
	(( PENDING )) || REPLY='rendering…'
}

# One step of the pipeline. The main loop calls it on every pass.
preview_tick() {
	handshake_tick
	if (( PENDING )) && (( NOW - PENDING_AT >= DEBOUNCE_MS )); then
		# An image job needs the answers of the terminal: graphics support and cell size.
		if (( ! HS_PENDING && NOW >= CELL_WAIT_UNTIL )); then
			job_start
		fi
	fi
	tx_pump
	tx_check
	job_poll
	preload_tick
}

# Sets REPLY to the wait of the main loop for input: "none" while data can go
# out, "busy". This happens while something is pending, "idle" for the rest.
preview_timeout() {
	if (( TX_ACTIVE && ! TX_WAIT && ! TX_PAUSED )); then
		REPLY=none
	elif (( PENDING || HS_PENDING || TX_PAUSED )) || { [[ -n $JOB_DIR ]] && (( ! JOB_FINISHED )); }; then
		REPLY=busy
	elif (( TX_WAIT )) && [[ $ACK_MODE != on ]]; then
		REPLY=busy
	elif (( TX_CHECK_UNTIL || TX_RETRY_AT > NOW )); then
		REPLY=busy
	elif [[ -n $PF_KEY ]] && (( ! PF_FINISHED || ! TX_ACTIVE )); then
		REPLY=busy
	else
		REPLY=idle
	fi
}
