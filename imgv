gfx_init() {
	if (( IN_TMUX )); then
		GFX_PRE=$'\ePtmux;\e\e_G' GFX_SUF=$'\e\e\\\e\\'
		DSR=$'\ePtmux;\e\e[5n\e\\'
	else
		GFX_PRE=$'\e_G' GFX_SUF=$'\e\\'
		DSR=$'\e[5n'
	fi
	local hex code mark
	printf -v PH '\U0010EEEE'
	DIA=()
	for hex in $DIA_HEX; do
		printf -v code '%08X' "0x$hex"
		printf -v mark '%b' "\\U$code"
		DIA+=("$mark")
	done
	# The image id travels in a color of the base palette, which every
	# terminal setup keeps intact. The process id spreads the ids of two
	# programs in one terminal.
	ID_A=$(( 16 + $$ % 119 * 2 ))
	ID_B=$(( ID_A + 1 ))
}

# Appends one graphics command to the frame.
gfx_cmd() {
	FRAME+="$GFX_PRE$1$GFX_SUF"
}

# Sets REPLY to the placeholder cells of image $1 at column $2, row $3,
# for a box of $4 columns and $5 rows.
placeholder_block() {
	local id=$1 x=$2 y=$3 cols=$4 rows=$5 row tail=''
	local out=''
	# Only the first cell of a row carries its row and column. A cell with
	# no marks continues the cell on its left, which halves the bytes.
	repeat $(( cols - 1 )) "$PH"
	tail=$REPLY
	for (( row = 0; row < rows; row++ )); do
		out+=$'\e['"$(( y + row ));${x}H$PH${DIA[row]}${DIA[0]}$tail"
	done
	REPLY=$'\e[38;5;'"${id}m$out"$'\e[39m'
}

# Handles one answer to a graphics command.
gfx_reply() {
	[[ $1 == Gi=1\;OK* ]] || return 0
	[[ $GFX == unknown || $GFX == unsupported ]] || return 0
	GFX=on
	D_DETAILS=1
	(( HS_PENDING )) || preview_restart
}

# Handles one status report from the terminal.
ack_received() {
	(( ACKS < PROBES )) && (( ACKS++ ))
	ACK_SEEN=1 ACK_MISSES=0
	if [[ $ACK_MODE == off ]] && (( ! HS_PENDING )); then
		ACK_MODE=on ACKS=$PROBES TX_WIN=$WIN_START
		(( TX_WIN > WIN_CAP )) && TX_WIN=$WIN_CAP
		status 'the terminal answers again: flow control is on'
	fi
	return 0
}

# Without answers the program cannot see the link. It then sends at a fixed rate.
ack_mode_off() {
	ACK_MODE=off
	(( RATE_NOW )) || RATE_NOW=$RATE_BPS
	rate_window
	human_size "$RATE_NOW"
	status "the terminal does not answer: no flow control, sending $REPLY/s (--rate)"
}

# Sets the window of the fixed-rate mode: a tenth of a second of data.
rate_window() {
	TX_WIN=$(( RATE_NOW / 10 ))
	(( TX_WIN < CHUNK )) && TX_WIN=$CHUNK
	(( TX_WIN > WIN_CAP )) && TX_WIN=$WIN_CAP
}

# Sets TMUX_TAKEN and TMUX_DISCARDED to two byte counts of the tmux client.
# tmux counts a byte as taken when it queues it, not when the client reads
# it. It counts a byte as discarded when it empties a queue that grew too long.
tmux_counters() {
	(( IN_TMUX )) || return 1
	local reply
	reply=$(tmux display-message -p -t "$TMUX_PANE" '#{client_written}:#{client_discarded}' 2>/dev/null) || return 1
	[[ $reply == +([0-9]):+([0-9]) ]] || return 1
	TMUX_TAKEN=${reply%:*} TMUX_DISCARDED=${reply#*:}
}

# tmux loses image data in two ways, and reports neither to the program.
# It empties its queue when the link is slower than the send rate. It also
# drops data while a redraw of the pane waits behind queued output.
# Succeeds when the counters show a loss. The first kind sets TX_LOST at once.
tmux_dropped() {
	(( TX_BASE >= 0 )) || return 1
	tmux_counters || return 1
	if (( TMUX_DISCARDED > TX_DISCARDED )); then
		TX_LOST=1
		return 0
	fi
	(( TMUX_TAKEN - TX_BASE < TX_SENT ))
}

# After a loss the whole image goes out again, at half the rate.
tx_lost() {
	tx_abort
	(( RATE_NOW /= 2 ))
	(( RATE_NOW < WIN_MIN )) && RATE_NOW=$WIN_MIN
	rate_window
	now_ms
	STAGE_DONE=0 TX_LOST=0 TX_CHECK_UNTIL=0
	TX_RETRY_AT=$(( NOW + RETRY_MS ))
	human_size "$RATE_NOW"
	status "tmux dropped image data: sending the image again at $REPLY/s"
}

# The queue of tmux can still overflow a moment after the last byte went
# out. This check finds that loss.
tx_check() {
	(( TX_CHECK_UNTIL )) || return 0
	(( NOW - TX_CHECK_AT >= 200 )) || return 0
	TX_CHECK_AT=$NOW
	(( NOW >= TX_CHECK_UNTIL )) && TX_CHECK_UNTIL=0
	tmux_dropped && (( TX_LOST )) && tx_lost
	return 0
}

# Adapts the window to the time that the last window needed.
link_update() {
	local dt=$1 drain next bps
	(( dt < 1 )) && dt=1
	(( RTT_MS == 0 || dt < RTT_MS )) && RTT_MS=$dt
	bps=$(( TX_WIN_SENT * 1000 / dt ))
	# A small window can pass in one burst of the link. One sample
	# therefore counts as the double of the estimate at most.
	(( LINK_BPS && bps > LINK_BPS * 2 )) && bps=$(( LINK_BPS * 2 ))
	LINK_BPS=$(( LINK_BPS ? (LINK_BPS * 3 + bps) / 4 : bps ))
	# A short last window says little about the link.
	(( TX_WIN_SENT * 2 < TX_WIN )) && return 0
	drain=$(( dt - RTT_MS ))
	(( drain < 1 )) && drain=1
	next=$(( TX_WIN_SENT * WIN_TARGET_MS / drain ))
	(( next > TX_WIN * 2 )) && next=$(( TX_WIN * 2 ))
	(( next < TX_WIN / 2 )) && next=$(( TX_WIN / 2 ))
	(( next < WIN_MIN )) && next=$WIN_MIN
	(( next > WIN_CAP )) && next=$WIN_CAP
	TX_WIN=$next
	D_FOOTER=1
}

# Starts the transfer of the base64 file $1, which holds $2 bytes.
tx_begin() {
	tx_abort
	[[ -r $1 ]] || return 1
	exec {TX_FD}< "$1"
	# A later stage of the shown image keeps its id. The terminal then
	# replaces the picture in place, and the cells stay as they are.
	if (( SHOWN_ID && STAGE_DONE > 0 )); then
		TX_ID=$SHOWN_ID
	elif (( SHOWN_ID == ID_A )); then
		TX_ID=$ID_B
	else
		TX_ID=$ID_A
	fi
	TX_ACTIVE=1 TX_STARTED=0 TX_EOF=0 TX_WAIT=0 TX_PAUSED=0
	TX_TOTAL=$2 TX_SENT=0 TX_WIN_SENT=0
	# In fixed-rate mode one question at the start finds a terminal that answers again.
	if [[ $ACK_MODE == off ]] && pane_focused; then
		printf '%s' "$DSR"
		(( PROBES++ ))
	fi
	TX_BASE=-1 TX_LOST=0 TX_CHECK_UNTIL=0
	if [[ $ACK_MODE == off ]] && tmux_counters; then
		TX_BASE=$TMUX_TAKEN
		# A later stage keeps the count of the first one, so a loss
		# between two stages still shows.
		(( STAGE_DONE > 0 )) || TX_DISCARDED=$TMUX_DISCARDED
	fi
	D_DETAILS=1
}

# Stops the transfer. An empty last chunk ends the open command, so the
# terminal drops the partial image.
tx_abort() {
	(( TX_ACTIVE )) || return 0
	exec {TX_FD}<&-
	local out=
	(( TX_STARTED && ! TX_EOF )) && out+="${GFX_PRE}q=2,m=0;${GFX_SUF}"
	(( TX_STARTED && TX_ID != SHOWN_ID )) && out+="${GFX_PRE}q=2,a=d,d=I,i=${TX_ID}${GFX_SUF}"
	printf '%s' "$out"
	TX_ACTIVE=0 TX_WAIT=0 TX_PAUSED=0
	D_DETAILS=1
}

# Returns success when the window in flight has left the link.
tx_window_released() {
	now_ms
	if [[ $ACK_MODE == on ]]; then
		if (( ACKS >= TX_NEED )); then
			link_update $(( NOW - TX_WIN_AT ))
		elif (( NOW - TX_PROBE_AT < ACK_TIMEOUT_MS )); then
			return 1
		else
			# The answer is lost. Count it as received so the next wait starts clean.
			ACKS=$PROBES
			(( ! ACK_SEEN || ++ACK_MISSES >= 3 )) && ack_mode_off
		fi
	elif (( (NOW - TX_WIN_AT) * RATE_NOW < TX_WIN_SENT * 1000 )); then
		return 1
	elif tmux_dropped; then
		# tmux can be a moment behind with its count of taken bytes, so
		# that verdict waits a little.
		(( NOW - TX_PROBE_AT > 500 )) && TX_LOST=1
		return 1
	fi
	TX_WAIT=0 TX_WIN_SENT=0
	# Fixed-rate mode counts the bytes of tmux, so it must not add screen
	# updates of its own between two windows.
	[[ $ACK_MODE == on ]] && D_DETAILS=1
	return 0
}

# Sends the next part of the image. It returns after one burst at most.
tx_pump() {
	(( TX_ACTIVE )) || return 0
	if (( TX_WAIT )); then
		if ! tx_window_released; then
			(( TX_LOST )) && tx_lost
			return 0
		fi
	fi
	if (( TX_EOF )); then
		tx_done
		return 0
	fi
	if ! pane_focused; then
		(( TX_PAUSED )) || D_DETAILS=1
		TX_PAUSED=1
		return 0
	fi
	(( TX_PAUSED )) && D_DETAILS=1
	TX_PAUSED=0

	local burst=$BURST chunk ctrl more out='' n
	if (( TX_WIN_SENT == 0 )); then
		now_ms
		TX_WIN_AT=$NOW
	fi
	# A window holds whole chunks and never more bytes than TX_WIN.
	while (( burst > 0 && ! TX_EOF && (TX_WIN_SENT == 0 || TX_WIN_SENT + CHUNK <= TX_WIN) )); do
		IFS= read -r -N "$CHUNK" -u "$TX_FD" chunk || TX_EOF=1
		more=$(( ! TX_EOF ))
		if (( TX_STARTED )); then
			ctrl="q=2,m=$more"
		else
			ctrl="q=2,a=T,U=1,f=100,i=$TX_ID,c=$BOX_C,r=$BOX_R,m=$more"
			TX_STARTED=1
		fi
		out+="$GFX_PRE$ctrl;$chunk$GFX_SUF"
		n=${#chunk}
		(( burst -= n, TX_SENT += n, TX_WIN_SENT += n ))
	done
	if (( TX_EOF || TX_WIN_SENT + CHUNK > TX_WIN )); then
		if [[ $ACK_MODE == on ]]; then
			out+=$DSR
			(( PROBES++ ))
			TX_NEED=$PROBES
		fi
		TX_WAIT=1
		now_ms
		TX_PROBE_AT=$NOW
	fi
	printf '%s' "$out"
}

# The whole image is in the terminal: show it.
tx_done() {
	exec {TX_FD}<&-
	TX_ACTIVE=0
	STAGE_DONE=$TX_STAGE
	D_DETAILS=1
	(( TX_BASE >= 0 )) && TX_CHECK_UNTIL=$(( NOW + CHECK_MS ))
	(( TX_ID == SHOWN_ID )) && return 0
	placeholder_block "$TX_ID" "$BOX_X" "$BOX_Y" "$BOX_C" "$BOX_R"
	OLD_ID=$SHOWN_ID
	SHOWN_ID=$TX_ID SHOWN_PH=$REPLY
	PV_KIND=image
	D_PREVIEW=1
}

# Removes the shown image from the terminal.
image_hide() {
	(( SHOWN_ID )) || return 0
	gfx_cmd "q=2,a=d,d=I,i=$SHOWN_ID"
	SHOWN_ID=0 SHOWN_PH=
}
# bashfs: end graphics.bash
# bashfs: begin preview.bash
# The preview pipeline: selection, then job, then transfer, then picture.

# The selection changed. Stops all work for the entry and starts the rest
# timer for the new entry.
preview_reset() {
	tx_abort
	job_kill
	image_hide
	JOB_INFO=() PV_TEXT=() PV_KIND=none PV_MSG=
	GOT_INFO=0 GOT_TEXT=0 GOT_ERR=0 GOT_GEOM=0
	STAGES=0 STAGE_DONE=0 TX_STAGE=0
	now_ms
	PENDING=1 PENDING_AT=$NOW
	D_DETAILS=1 D_PREVIEW=1
}

# Starts the preview of the same entry again, for example after a resize.
preview_restart() {
	preview_reset
}

job_kill() {
	if (( JOB_PID && ! JOB_FINISHED )); then
		kill "$JOB_PID" 2>/dev/null
	fi
	JOB_DIR='' JOB_PID=0 JOB_KEY='' JOB_FINISHED=0
}

# Starts the job for the selected entry, or takes a finished job from the cache.
job_start() {
	PENDING=0
	(( N > 0 )) || return 0
	local name=${E_NAME[CUR]} kind=other
	local path=${PWD%/}/$name
	local -a args=()
	case ${E_KIND[CUR]} in
		d) kind='dir' ;;
		f) kind='file' ;;
	esac
	if (( E_IMG[CUR] )); then
		kind=image
		local max_w=0 max_h=0
		if [[ $GFX == on ]] && (( P_H > 0 )); then
			stage_limit
			max_w=$FIT_W max_h=$FIT_H
		fi
		args=("$max_w" "$max_h" "${E_SIZE[CUR]}")
	fi

	local key="$kind|$path|${E_MTIME[CUR]}|${E_SIZE[CUR]}|${args[*]}|$SHOW_HIDDEN"
	JOB_FINISHED=0 JOB_PID=0
	if [[ -n ${CACHE[$key]-} && -e ${CACHE[$key]}/done ]]; then
		JOB_DIR=${CACHE[$key]} JOB_KEY=
		return 0
	fi
	JOB_DIR=$RUN_DIR/job$(( ++JOB_SEQ )) JOB_KEY=$key
	mkdir -p -- "$JOB_DIR" || { status 'cannot create a work directory'; JOB_DIR=; return 0; }
	job_spawn "$kind" "$path" "$JOB_DIR" "${args[@]}"
	if [[ $kind == image ]] && (( max_w > 0 )); then
		PV_KIND=msg PV_MSG='loading…' D_PREVIEW=1
	fi
}

# Keeps a finished job for the session. The oldest job leaves the cache first.
cache_add() {
	[[ -n $JOB_KEY ]] || return 0
	CACHE[$JOB_KEY]=$JOB_DIR
	CACHE_ORDER+=("$JOB_KEY")
	JOB_KEY=
	(( ${#CACHE_ORDER[@]} > CACHE_MAX )) || return 0
	local old=${CACHE_ORDER[0]}
	CACHE_ORDER=("${CACHE_ORDER[@]:1}")
	rm -rf -- "${CACHE[$old]}"
	unset 'CACHE[$old]'
}

# Picks up the result files that the job has published since the last look.
job_poll() {
	[[ -n $JOB_DIR ]] || return 0
	local dir=$JOB_DIR
	if (( ! GOT_INFO )) && [[ -e $dir/info ]]; then
		mapfile -t JOB_INFO < "$dir/info"
		GOT_INFO=1 D_DETAILS=1
	fi
	if (( ! GOT_TEXT )) && [[ -e $dir/text ]]; then
		mapfile -t PV_TEXT < "$dir/text"
		GOT_TEXT=1 PV_KIND=text D_PREVIEW=1
	fi
	if (( ! GOT_ERR )) && [[ -e $dir/err ]]; then
		IFS= read -r PV_MSG < "$dir/err"
		GOT_ERR=1 PV_KIND=error D_PREVIEW=1 D_DETAILS=1
	fi
	if (( ! GOT_GEOM )) && [[ -e $dir/geom ]]; then
		read -r IMG_W IMG_H STAGES < "$dir/geom"
		GOT_GEOM=1
		box_compute
	fi
	if (( GOT_GEOM && ! TX_ACTIVE && STAGE_DONE < STAGES && NOW >= TX_RETRY_AT )) && [[ $GFX == on ]]; then
		stage_send
	fi
	if (( ! JOB_FINISHED )) && [[ -e $dir/done ]]; then
		JOB_FINISHED=1
		cache_add
	fi
	return 0
}

# Starts the transfer of the next stage that is ready.
stage_send() {
	local dir=$JOB_DIR stage=$(( STAGE_DONE + 1 ))
	# The draft stage only helps when the last stage needs a long time.
	if (( stage < STAGES )) && [[ -e $dir/s$STAGES.b64 ]] && (( LINK_BPS > 0 )); then
		local w h bytes
		read -r w h bytes < "$dir/s$STAGES.dim"
		(( bytes * 1000 / LINK_BPS < WIN_TARGET_MS * 2 )) && stage=$STAGES
	fi
	[[ -e $dir/s$stage.b64 ]] || return 0
	read -r STAGE_W STAGE_H STAGE_BYTES < "$dir/s$stage.dim"
	TX_STAGE=$stage
	tx_begin "$dir/s$stage.b64" "$STAGE_BYTES"
}

# Sets REPLY to the text of the Preview line in the details.
preview_status() {
	REPLY=
	(( N > 0 && E_IMG[CUR] )) || return 0
	case $GFX in
		off) REPLY='off (press i)'; return ;;
		unsupported) REPLY='no graphics support in this terminal (press i to force)'; return ;;
		unknown) REPLY='asking the terminal…'; return ;;
		noutf8) REPLY='tmux is not in UTF-8 mode: attach with "tmux -u", then press i'; return ;;
	esac
	if [[ $PV_KIND == error ]]; then
		REPLY='failed'
		return
	fi
	local label=draft size
	(( TX_STAGE >= STAGES )) && label=${QUALITY_NAME[QUALITY]}
	if (( TX_ACTIVE )); then
		human_size "$TX_TOTAL"
		size=$REPLY
		if [[ $ACK_MODE == on ]]; then
			REPLY="$label ${STAGE_W}×${STAGE_H} · $(( TX_TOTAL ? TX_SENT * 100 / TX_TOTAL : 0 ))% of $size"
		else
			REPLY="$label ${STAGE_W}×${STAGE_H} · sending $size, no flow control"
		fi
		(( TX_PAUSED )) && REPLY+=' · paused, pane not focused'
		return
	fi
	if (( STAGE_DONE > 0 )); then
		human_size "$STAGE_BYTES"
		REPLY="$label ${STAGE_W}×${STAGE_H} · $REPLY"
		(( STAGE_DONE < STAGES )) && REPLY+=' · refining…'
		return
	fi
	(( PENDING )) || REPLY='rendering…'
}

# One step of the pipeline. The main loop calls it on every pass.
preview_tick() {
	handshake_tick
	if (( PENDING )) && (( NOW - PENDING_AT >= DEBOUNCE_MS )); then
		# An image job needs the answers of the terminal: graphics support and cell size.
		if (( ! HS_PENDING && NOW >= CELL_WAIT_UNTIL )); then
			job_start
		fi
	fi
	tx_pump
	tx_check
	job_poll
}

# Returns the read timeout for the main loop: zero while data can go out,
# short while something is pending, long when idle.
preview_timeout() {
	if (( TX_ACTIVE && ! TX_WAIT && ! TX_PAUSED )); then
		REPLY=0
	elif (( PENDING || HS_PENDING || TX_PAUSED )) || { [[ -n $JOB_DIR ]] && (( ! JOB_FINISHED )); }; then
		REPLY=$TICK_BUSY_S
	elif (( TX_WAIT )) && [[ $ACK_MODE != on ]]; then
		REPLY=$TICK_BUSY_S
	else
		REPLY=$TICK_IDLE_S
	fi
}
# bashfs: end preview.bash
# bashfs: begin draw.bash
# Drawing. Every function appends to FRAME, and flush writes the frame once.
# Each part of the screen has a dirty flag, so a key press sends few bytes.

flush() {
	[[ -n $FRAME ]] || return 0
	# The terminal shows a synchronized update in one step.
	printf '\e[?2026h%s\e[?2026l' "$FRAME"
	FRAME=
}

# Appends a cursor move to row $1, column $2.
at() {
	FRAME+=$'\e['"$1;$2H"
}

# Erases the rectangle at column $1, row $2 with $3 columns and $4 rows.
clear_rect() {
	local row
	for (( row = $2; row < $2 + $4; row++ )); do
		FRAME+=$'\e['"$row;$1H"$'\e['"$3X"
	done
}

draw_header() {
	local path=$PWD width=$(( COLS - 2 ))
	[[ $path == "$HOME" || $path == "$HOME"/* ]] && path="~${path#"$HOME"}"
	(( ${#path} > width && width > 1 )) && path="…${path: -$(( width - 1 ))}"
	fit "$path" "$width"
	at 1 1
	FRAME+="$S_BAR $REPLY $S_RESET"
}

draw_footer() {
	local left right style=$S_DIM
	if [[ $MODE == search ]]; then
		left="/$SEARCH" style=
	elif [[ -n $STATUS ]]; then
		left=$STATUS style=$S_BOLD
	else
		left='j/k move  h/l dir  z zoom  +/- quality  / search  ? help  q quit'
	fi
	right="$(( N ? CUR + 1 : 0 ))/$N  $SORT  ${QUALITY_NAME[QUALITY]}"
	if (( LINK_BPS )); then
		human_size "$LINK_BPS"
		right+="  $REPLY/s"
	fi
	(( ${#right} + 12 > COLS )) && right=
	fit " $left" $(( COLS - ${#right} - 1 ))
	at "$ROWS" 1
	FRAME+="$style$REPLY$S_RESET$S_DIM$right $S_RESET"
}

# Draws the list row of entry $1 when that row is on the screen.
draw_list_row() {
	local i=$1
	(( L_H > 0 && i >= TOP && i < TOP + L_H )) || return 0
	at $(( L_Y + i - TOP )) "$L_X"
	if (( i >= N )); then
		fit '' "$L_W"
		(( i == 0 )) && fit ' (empty)' "$L_W"
		FRAME+="$S_DIM$REPLY$S_RESET"
		return 0
	fi
	local name=${E_NAME[i]} style='' size='' line
	case ${E_KIND[i]} in
		d) name+=/ style=$S_DIR ;;
		f)
			(( E_IMG[i] )) || style=$S_DIM
			human_size "${E_SIZE[i]}"
			size=$REPLY
			;;
		*) style=$S_DIM ;;
	esac
	(( E_LINK[i] )) && style=$S_LINK
	(( i == CUR )) && style=$S_SEL
	if (( L_W >= 34 )); then
		fit "$name" $(( L_W - 12 ))
		printf -v line ' %s %9s ' "$REPLY" "$size"
	else
		fit "$name" $(( L_W - 2 ))
		line=" $REPLY "
	fi
	FRAME+="$style$line$S_RESET"
}

draw_list() {
	local i
	for (( i = TOP; i < TOP + L_H; i++ )); do
		draw_list_row "$i"
	done
}

draw_separators() {
	local row
	FRAME+=$S_DIM
	if (( SEP_COL )); then
		for (( row = 2; row < ROWS; row++ )); do
			at "$row" "$SEP_COL"
			FRAME+='│'
		done
	fi
	if (( SEP_ROW )); then
		repeat "$COLS" '─'
		at "$SEP_ROW" 1
		FRAME+=$REPLY
	fi
	FRAME+=$S_RESET
}

# Builds DET, the lines of the details pane, as "Label<TAB>value".
details_compose() {
	DET=()
	(( N > 0 )) || return 0
	local when
	human_size "${E_SIZE[CUR]}"
	printf -v when '%(%Y-%m-%d %H:%M)T' "${E_MTIME[CUR]}"
	DET+=("Name"$'\t'"${E_NAME[CUR]}" "File"$'\t'"$REPLY · $when")
	(( ${#JOB_INFO[@]} )) && DET+=("${JOB_INFO[@]}")
	preview_status
	[[ -n $REPLY ]] || return 0
	# The Preview line always shows. It takes the last row when the pane is full.
	(( ${#DET[@]} >= D_H )) && DET=("${DET[@]:0:D_H-1}")
	DET+=("Preview"$'\t'"$REPLY")
}

draw_details() {
	(( D_H > 0 )) || return 0
	details_compose
	local i label
	for (( i = 0; i < D_H; i++ )); do
		at $(( D_Y + i )) "$D_X"
		if (( i >= ${#DET[@]} )); then
			FRAME+=$'\e['"${D_W}X"
			continue
		fi
		printf -v label '%-8s' "${DET[i]%%$'\t'*}"
		fit "${DET[i]#*$'\t'}" $(( D_W - 9 ))
		FRAME+="$S_DIM$label$S_RESET $REPLY"
	done
}

# Draws the preview pane. PV_PAINTED remembers what is on the screen. An
# empty pane is not erased again and a new stage of an image replaces the
# old stage without a blank moment.
draw_preview() {
	(( P_H > 0 )) || return 0
	local want=$PV_KIND
	[[ $want == image ]] && want="image $BOX_X $BOX_Y $BOX_C $BOX_R"
	if [[ -n $PV_PAINTED && $PV_PAINTED != "$want" ]]; then
		clear_rect "$P_X" "$P_Y" "$P_W" "$P_H"
	fi
	PV_PAINTED=
	local i
	case $PV_KIND in
		text)
			for (( i = 0; i < P_H && i < ${#PV_TEXT[@]}; i++ )); do
				fit "${PV_TEXT[i]}" "$P_W"
				at $(( P_Y + i )) "$P_X"
				FRAME+="$S_DIM$REPLY$S_RESET"
			done
			PV_PAINTED=text
			;;
		msg | error)
			local style=$S_DIM msg=$PV_MSG
			[[ $PV_KIND == error ]] && style=$S_ERR
			(( ${#msg} > P_W )) && msg="${msg:0:P_W-1}…"
			at $(( P_Y + P_H / 2 )) $(( P_X + (P_W - ${#msg}) / 2 ))
			FRAME+="$style$msg$S_RESET"
			PV_PAINTED=$PV_KIND
			;;
		image)
			if (( SHOWN_ID )); then
				FRAME+=$SHOWN_PH
				PV_PAINTED=$want
			fi
			;;
	esac
	if (( OLD_ID )); then
		gfx_cmd "q=2,a=d,d=I,i=$OLD_ID"
		OLD_ID=0
	fi
}

draw_help() {
	local -a lines=(
		'j k  ↓ ↑        move the selection'
		'g G  Home End   first, last entry'
		'PgDn PgUp  ^D ^U  page, half page'
		'l →  Enter      open a directory, zoom an image'
		'h ←  Backspace  parent directory'
		'~               home directory'
		'z  Tab          zoom: the preview fills the window'
		'+ -             preview quality (draft, normal, fine, full)'
		'i               image previews on or off'
		'/  n N          search, next match, previous match'
		's               sort by name, time, size'
		'.               show hidden files'
		'r  ^L           load again, draw again'
		'q               quit'
	)
	local width=58 height=$(( ${#lines[@]} + 2 )) i
	(( width > COLS - 2 )) && width=$(( COLS - 2 ))
	local x=$(( (COLS - width) / 2 + 1 )) y=$(( (ROWS - height) / 2 + 1 ))
	(( y < 1 )) && y=1
	for (( i = 0; i < height && y + i <= ROWS; i++ )); do
		at $(( y + i )) "$x"
		if (( i == 0 )); then
			fit " $PROG $VERSION: keys" "$width"
			FRAME+="$S_BAR$REPLY$S_RESET"
		elif (( i == height - 1 )); then
			fit ' press a key to close' "$width"
			FRAME+="$S_BAR$REPLY$S_RESET"
		else
			fit "  ${lines[i-1]}" "$width"
			FRAME+=$REPLY
		fi
	done
}

# Draws what the dirty flags name, then writes the frame.
render() {
	if (( TOO_SMALL )); then
		if (( D_ALL )); then
			fit 'window too small' "$COLS"
			FRAME+=$'\e[2J\e[1;1H'"$REPLY"
			D_ALL=0
		fi
		flush
		return
	fi
	if (( D_ALL )); then
		FRAME+=$'\e[0m\e[2J'
		PV_PAINTED=
		D_HEADER=1 D_LIST=1 D_DETAILS=1 D_PREVIEW=1 D_FOOTER=1
		draw_separators
	fi
	(( D_HEADER )) && draw_header
	if (( D_LIST )); then
		draw_list
	else
		local row
		for row in "${DIRTY_ROWS[@]}"; do
			draw_list_row "$row"
		done
	fi
	(( D_DETAILS )) && draw_details
	(( D_PREVIEW )) && draw_preview
	(( D_FOOTER )) && draw_footer
	if (( D_ALL )) && [[ $MODE == help ]]; then
		draw_help
	fi
	D_ALL=0 D_HEADER=0 D_LIST=0 D_DETAILS=0 D_PREVIEW=0 D_FOOTER=0
	DIRTY_ROWS=()
	flush
}
# bashfs: end draw.bash
# bashfs: begin input.bash
# Keyboard input. The answers of the terminal arrive on the same stream.

# Reads one key with the timeout $1, in seconds. Sets KEY, which stays empty
# for input that is not a key. Fails when no input arrived in time.
read_key() {
	local c
	KEY=
	IFS= read -rsN1 -t "$1" c
	local rc=$?
	if (( rc > 128 )); then
		return 1
	elif (( rc != 0 )); then
		# End of input: the terminal is gone.
		RUNNING=0
		return 1
	fi
	case $c in
		$'\e') read_escape ;;
		$'\n' | $'\r') KEY=ENTER ;;
		$'\x7f' | $'\b') KEY=BS ;;
		$'\t') KEY=TAB ;;
		*) KEY=$c ;;
	esac
	return 0
}

read_escape() {
	local c seq=''
	if ! IFS= read -rsN1 -t "$ESC_WAIT_S" c; then
		KEY=ESC
		return
	fi
	case $c in
		'[')
			# A control sequence ends at the first byte from "@" to "~".
			while IFS= read -rsN1 -t "$ESC_WAIT_S" c; do
				[[ $c == [@-~] ]] && break
				seq+=$c
				(( ${#seq} > 32 )) && break
			done
			csi_dispatch "$seq" "$c"
			;;
		O)
			IFS= read -rsN1 -t "$ESC_WAIT_S" c || return
			csi_dispatch '' "$c"
			;;
		_ | P | ']' | '^')
			read_string "$c"
			;;
	esac
}

# Consumes a string sequence up to its terminator. $1 is the introducer.
read_string() {
	local c prev='' body=''
	while IFS= read -rsN1 -t "$ESC_WAIT_S" c; do
		[[ $c == $'\a' ]] && break
		if [[ $prev == $'\e' && $c == $'\\' ]]; then
			body=${body%$'\e'}
			break
		fi
		body+=$c prev=$c
		(( ${#body} > 256 )) && break
	done
	[[ $1 == _ ]] && gfx_reply "$body"
	return 0
}

# Maps a control sequence to a key name or to an answer handler.
csi_dispatch() {
	local params=$1 final=$2
	case $final in
		A) KEY=UP ;;
		B) KEY=DOWN ;;
		C) KEY=RIGHT ;;
		D) KEY=LEFT ;;
		H) KEY=HOME ;;
		F) KEY=END ;;
		'~')
			case ${params%%;*} in
				1 | 7) KEY=HOME ;;
				4 | 8) KEY=END ;;
				5) KEY=PGUP ;;
				6) KEY=PGDN ;;
			esac
			;;
		n) [[ $params == 0 ]] && ack_received ;;
		t) [[ $params == 6\;* ]] && cell_reply "$params" ;;
	esac
	return 0
}

search_key() {
	case $1 in
		ENTER)
			MODE=normal
			;;
		ESC)
			MODE=normal
			select_index "$SEARCH_FROM"
			;;
		BS)
			if [[ -z $SEARCH ]]; then
				MODE=normal
			else
				SEARCH=${SEARCH%?}
				search_jump 1 "$SEARCH_FROM"
			fi
			;;
		?)
			SEARCH+=$1
			search_jump 1 "$SEARCH_FROM" || status "no match for: $SEARCH"
			;;
	esac
	D_FOOTER=1
}

quality_step() {
	local q=$(( QUALITY + $1 ))
	(( q < 1 || q >= ${#QUALITY_NAME[@]} )) && return 0
	QUALITY=$q
	status "preview quality: ${QUALITY_NAME[QUALITY]}"
	preview_restart
}

images_toggle() {
	case $GFX in
		on)
			GFX=off
			status 'image previews: off'
			;;
		unknown)
			return 0
			;;
		noutf8)
			if ! tmux_utf8; then
				status 'tmux is still not in UTF-8 mode: attach with "tmux -u"'
				return 0
			fi
			# The terminal is asked again, since the first answers were not kept.
			GFX=unknown
			handshake_send
			status 'image previews: on'
			;;
		*)
			# A terminal that gave no answer before is asked again.
			if [[ $GFX == off && $ACK_MODE == unknown ]]; then
				GFX=unknown
				handshake_send
			else
				GFX=on
			fi
			status 'image previews: on'
			;;
	esac
	preview_restart
}

handle_key() {
	local key=$1 page=$(( ROWS - 3 ))
	(( page < 1 )) && page=1
	case $MODE in
		help)
			MODE=normal D_ALL=1
			return
			;;
		search)
			search_key "$key"
			return
			;;
	esac
	if [[ -n $STATUS ]]; then
		STATUS='' D_FOOTER=1
	fi
	case $key in
		q) RUNNING=0 ;;
		j | DOWN) select_index $(( CUR + 1 )) ;;
		k | UP) select_index $(( CUR - 1 )) ;;
		g | HOME) select_index 0 ;;
		G | END) select_index $(( N - 1 )) ;;
		PGDN | $'\x06' | ' ') select_index $(( CUR + page )) ;;
		PGUP | $'\x02') select_index $(( CUR - page )) ;;
		$'\x04') select_index $(( CUR + page / 2 )) ;;
		$'\x15') select_index $(( CUR - page / 2 )) ;;
		l | RIGHT | ENTER) open_selection ;;
		h | LEFT | BS) dir_change .. "${PWD##*/}" ;;
		'~') dir_change "$HOME" ;;
		z | TAB) zoom_toggle ;;
		+ | =) quality_step 1 ;;
		- | _) quality_step -1 ;;
		i) images_toggle ;;
		.)
			SHOW_HIDDEN=$(( ! SHOW_HIDDEN ))
			dir_reload
			;;
		s)
			case $SORT in
				name) SORT='time' ;;
				time) SORT='size' ;;
				*) SORT='name' ;;
			esac
			dir_reload
			;;
		r) dir_reload ;;
		$'\x0c')
			D_ALL=1
			preview_restart
			;;
		/)
			MODE=search SEARCH='' SEARCH_FROM=$CUR D_FOOTER=1
			;;
		n) search_jump 1 $(( CUR + 1 )) || status 'no match' ;;
		N) search_jump -1 $(( CUR - 1 )) || status 'no match' ;;
		'?')
			MODE=help D_ALL=1
			;;
	esac
	return 0
}
# bashfs: end input.bash
# bashfs: begin main.bash
# Start-up, the main loop, and shutdown.

usage() {
	cat <<EOF
$PROG $VERSION - terminal file browser with image previews

Usage: $PROG [options] [directory | file]

Options:
  -a, --all            show hidden files
  -n, --no-images      start with image previews off
  -q, --quality LEVEL  preview quality: draft, normal, fine, full (default: normal)
      --rate KIB       send rate in KiB/s when the terminal gives no answers (default: 128)
  -h, --help           show this text
  -V, --version        show the version

Image previews need a terminal with the kitty graphics protocol (Ghostty, kitty).
They work inside tmux. ffmpeg decodes the images. Without ffmpeg only PNG files
have a preview. Press ? in the program for the keys.
EOF
}

parse_args() {
	local arg i
	while (( $# )); do
		arg=$1
		shift
		case $arg in
			-a | --all) SHOW_HIDDEN=1 ;;
			-n | --no-images) GFX=off ;;
			-q | --quality)
				(( $# )) || die "$arg needs a value"
				QUALITY=0
				for (( i = 1; i < ${#QUALITY_NAME[@]}; i++ )); do
					[[ $1 == "${QUALITY_NAME[i]}" || $1 == "$i" ]] && QUALITY=$i
				done
				(( QUALITY )) || die "unknown quality: $1 (use draft, normal, fine or full)"
				shift
				;;
			--rate)
				(( $# )) || die "$arg needs a value"
				if [[ $1 != +([0-9]) ]] || (( $1 < 1 )); then
					die "--rate needs a positive number of KiB/s, not: $1"
				fi
				RATE_BPS=$(( $1 * 1024 ))
				shift
				;;
			-h | --help)
				usage
				exit 0
				;;
			-V | --version)
				printf '%s %s\n' "$PROG" "$VERSION"
				exit 0
				;;
			--)
				(( $# )) && START_PATH=$1
				(( $# > 1 )) && die 'too many arguments'
				return 0
				;;
			-*) die "unknown option: $arg (see --help)" ;;
			*)
				[[ $START_PATH == . ]] || die 'too many arguments'
				START_PATH=$arg
				;;
		esac
	done
}

cleanup() {
	trap - EXIT
	if (( TERM_READY )); then
		tx_abort
		printf '%s' "${GFX_PRE}q=2,a=d,d=I,i=${ID_A}${GFX_SUF}${GFX_PRE}q=2,a=d,d=I,i=${ID_B}${GFX_SUF}"
		term_restore
	fi
	job_kill
	tmux_restore
	[[ -n $RUN_DIR ]] && rm -rf -- "$RUN_DIR"
	return 0
}

on_resize() {
	RESIZED=0
	layout
	scroll_fix
	D_ALL=1
	now_ms
	[[ $GFX == on ]] && cell_query
	preview_restart
}

main() {
	(( BASH_VERSINFO[0] >= 5 )) || die 'bash 5 or later is needed'
	state_init
	parse_args "$@"

	local start_name=
	if [[ -d $START_PATH ]]; then
		cd -- "$START_PATH" || die "cannot open $START_PATH"
	elif [[ -e $START_PATH ]]; then
		start_name=${START_PATH##*/}
		[[ $START_PATH == */* ]] && { cd -- "${START_PATH%/*}/" || die "cannot open ${START_PATH%/*}"; }
	else
		die "no such file or directory: $START_PATH"
	fi
	[[ -t 0 && -t 1 ]] || die 'needs a terminal on standard input and output'

	# Text width and the placeholder characters need a UTF-8 locale.
	case ${LC_ALL:-${LC_CTYPE:-${LANG-}}} in
		*[Uu][Tt][Ff]-8 | *[Uu][Tt][Ff]8) ;;
		*) export LC_ALL=C.UTF-8 ;;
	esac

	command -v ffmpeg >/dev/null && HAVE_FFMPEG=1
	command -v ffprobe >/dev/null && HAVE_FFPROBE=1
	command -v file >/dev/null && HAVE_FILE=1
	# GNU stat takes its format after -c, BSD stat after -f.
	if stat -c %s . >/dev/null 2>&1; then
		STAT_LIST=(-c '%s/%.9Y') STAT_MODE=(-c '%A  %U:%G')
	else
		STAT_LIST=(-f '%z/%Fm') STAT_MODE=(-f '%Sp  %Su:%Sg')
	fi
	[[ -n ${TMUX-} && -n ${TMUX_PANE-} ]] && IN_TMUX=1

	RUN_DIR=$(mktemp -d "${TMPDIR:-/tmp}/$PROG.XXXXXX") || die 'cannot create a work directory'
	trap cleanup EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM HUP
	trap 'RESIZED=1' WINCH

	gfx_init
	if (( IN_TMUX )) && [[ $GFX != off ]]; then
		tmux_setup
	fi
	term_init
	layout
	dir_load
	dir_find "$start_name"
	CUR=$REPLY
	scroll_fix
	now_ms
	[[ $GFX == off ]] || handshake_send
	(( HAVE_FFMPEG )) || [[ $GFX == off ]] || status 'ffmpeg is not installed: only PNG files have a preview'
	if (( IN_TMUX )) && [[ $GFX != off ]] && ! tmux_utf8; then
		GFX=noutf8
		status 'tmux is not in UTF-8 mode, so images cannot show: attach with "tmux -u"'
	fi
	preview_reset
	render

	local drained
	while (( RUNNING )); do
		preview_timeout
		if [[ $REPLY == 0 ]]; then
			read -t 0 && read_key "$ESC_WAIT_S" && [[ -n $KEY ]] && handle_key "$KEY"
		else
			read_key "$REPLY" && [[ -n $KEY ]] && handle_key "$KEY"
		fi
		# Handle all keys that wait before one redraw.
		drained=0
		while (( RUNNING && drained++ < 64 )) && read -t 0; do
			read_key "$ESC_WAIT_S" && [[ -n $KEY ]] && handle_key "$KEY"
		done
		now_ms
		(( RESIZED )) && on_resize
		if [[ -n $STATUS ]] && (( NOW - STATUS_AT > STATUS_MS )); then
			STATUS='' D_FOOTER=1
		fi
		preview_tick
		render
	done
}
# bashfs: end main.bash

main "$@"
