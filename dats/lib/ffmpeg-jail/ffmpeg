#!/bin/sh
# Stands in for an ffmpeg that a sandbox keeps out of the work directory of
# imgv: it fails on each path in that directory as the real one fails, even as
# root. Other calls go to the next ffmpeg on the PATH. POSIX sh, because the
# busybox test PATH has no bash.
here=$(cd "${0%/*}" && pwd)
# JAIL_PIPES=1 keeps it out of the pipes too. JAIL_PIPES=user acts as an ffmpeg
# that runs as another user: it opens a pipe in /proc only when all may read and write it.
# JAIL_PIPES=decode lets ffmpeg probe but fails each decode.
deny() {
	echo "Error opening input files: Permission denied" >&2
	exit 1
}
for arg; do
	case ${JAIL_PIPES-}:$arg in
		*:"${TMPDIR:-/tmp}"/imgv.* | 1:/proc/* | 1:pipe:*) deny ;;
		decode:-filter_complex) deny ;;
		user:/proc/self/fd/[01]) [ "$(stat -L -c %a "/proc/$$/fd/${arg##*/}")" = 666 ] || deny ;;
	esac
done
IFS=:
for dir in $PATH; do
	[ "$dir" != "$here" ] && [ -x "$dir/ffmpeg" ] && exec "$dir/ffmpeg" "$@"
done
echo 'ffmpeg-jail: no ffmpeg behind this one on the PATH' >&2
exit 127
